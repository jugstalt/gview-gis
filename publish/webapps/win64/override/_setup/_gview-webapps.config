{
  "RepositoryPath": "{repository-path}/apps",
	"Authentication": {
		"Type": "forms",
		"Forms": {
			"AdminUsers": [
				{
					"Username": "{admim-username}",
					"PasswordHash": "{admim-password}"
				}
			],
			"CartoUsers": [
				{
					"Username": "{carto-username}",
					"PasswordHash": "{carto-password}"
				}
			]
		}
	},
	"Drives": {
		"TILE_CACHES": "{repository-path}/server/web/tile-caches",
		"USER": "{repository-path}/users/{{username}}"
	},
	"CustomTiles": [
		{
			"Title": "Local gView Server",
			"Description": "gView Server in development environment",
			"TargetUrl": "{server-url}"
		}
	],

	"__oidc_Authentication": {
		"Type": "oidc",
		"RequiredUserRole": "gview-web-user",
		"RequiredAdminRole": "gview-web-admin",
		"Oidc": {
			"Authority": "",
			"ClientId": "",
			"ClientSecret": "",
			"scopes":["openid", "profile", "role"]
		}
	},
}