{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/gView.Server/gView.Server.csproj",
        "--no-build",
        "--launch-profile",
        "https"
      ],
      "port": 44330,
      "url": "http://localhost:44330",
      "autoPort": false
    },
    {
      "name": "webapps",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Blazor/gView.WebApps/gView.WebApps.csproj",
        "--no-build",
        "--",
        "--urls",
        "http://localhost:5099"
      ],
      "port": 5099,
      "url": "http://localhost:5099",
      "autoPort": false
    },
    {
      "name": "vtc-viewer",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "src"
      ],
      "port": 5180,
      "url": "http://localhost:5180"
    },
    {
      "name": "glvt-example",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5181",
        "--directory",
        "../leaflet-gl-vectortiles"
      ],
      "port": 5181
    }
  ]
}