<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- projections database (SpatialReference.FromID): copied to the output/publish directory of every project referencing this library -->
    <None Remove="proj.db" />
    <Content Include="proj.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Proj4Net.Core" Version="2.26.4702" />
    <!-- Flows to all dependents (gView's public geometry classes implement its interfaces), but only this project uses it (ADR 0002) -->
    <PackageReference Include="SpatialNET.Extensions" Version="0.10.0-preview.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="gView.Framework.Geometry.Tests" />
    <InternalsVisibleTo Include="gView.Framework.Geometry.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gView.Framework.Core\gView.Framework.Core.csproj" />
    <ProjectReference Include="..\gView.Framework.Db\gView.Framework.Db.csproj" />
    <ProjectReference Include="..\gView.Framework.Calc\gView.Framework.Calc.csproj" />
    <ProjectReference Include="..\gView.Framework\gView.Framework.csproj" />
  </ItemGroup>

</Project>
