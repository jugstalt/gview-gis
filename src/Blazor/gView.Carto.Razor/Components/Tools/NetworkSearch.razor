@using gView.Carto.Razor.Components.Tools.ToolEvents
@using gView.Framework.NetworkModel.Graph
@using gView.Framework.NetworkModel.Query
@using gView.Carto.Razor.Components.Tools.Context

@inherits BaseHandler
@implements IDisposable

@inject ICartoApplicationScopeService AppScope
@inject CartoEventBusService EventBus
@inject IconService Icons
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@if (_context is not null)
{
    <MudMenu Label="@_context.Operation" Dense="true" title="Search">
        @foreach (var operation in NetworkSearchContext.Operations)
        {
            <MudMenuItem OnClick="() => OperationChanged(operation)">@operation</MudMenuItem>
        }
    </MudMenu>

    @if (_context.NeedsStart)
    {
        <div class="@($"carto-tool {(_context.Pick == NetworkSearchPick.Start ? "selected" : "")}")"
             title="@($"{StartLabel}: click {(_context.PicksEdge ? "a line" : "a node or a line end")} in the map{(_context.StartAllowsMany ? ", Ctrl-click adds or removes one" : "")}{PickedTooltip(_context.StartItems)}")"
             @onclick="() => SetPick(NetworkSearchPick.Start)">
            <div class=@Icons.FromString("basic:pin")></div>
            <div class="title">@PickedCount(_context.StartItems, _context.PicksEdge, StartLabel)</div>
        </div>
    }
    @if (_context.NeedsTarget)
    {
        <div class="@($"carto-tool {(_context.Pick == NetworkSearchPick.Target ? "selected" : "")}")"
             title="@($"{TargetLabel}: click a node or a line end in the map{(_context.TargetAllowsMany ? ", Ctrl-click adds or removes one" : "")}{PickedTooltip(_context.TargetItems)}")"
             @onclick="() => SetPick(NetworkSearchPick.Target)">
            <div class=@Icons.FromString("basic:pin")></div>
            <div class="title">@PickedCount(_context.TargetItems, false, TargetLabel)</div>
        </div>
    }

    @if (_context.Operation != "info")
    {
        <div class="@($"carto-tool {(_context.Pick == NetworkSearchPick.Area ? "selected" : "")}")"
             title="@($"Area: click a polygon feature in the map (e.g. a station polygon) or Ctrl-drag a box; only the nodes inside take part{(_context.Area is null ? "" : $"\nNow: {_context.AreaLabel}")}")"
             @onclick="() => SetPick(NetworkSearchPick.Area)">
            <div class=@Icons.FromString("webgis:polygon")></div>
            <div class="title">@(_context.Area is null ? "Area" : "Area ✓")</div>
        </div>
        <div class="tool-small-chunk">
            <div class="carto-tool small" title="The current map extent becomes the area" @onclick="() => Fire(NetworkSearchAction.AreaFromExtent)">
                <div class=@Icons.FromString("webgis:extent", IconSize.Small)></div>
                <div class="title">Extent</div>
            </div>
            <div class="carto-tool small" title="The selected polygon features become the area" @onclick="() => Fire(NetworkSearchAction.AreaFromSelection)">
                <div class=@Icons.FromString("webgis:polygon-selected", IconSize.Small)></div>
                <div class="title">Selection</div>
            </div>
            @if (_context.Area is not null)
            {
                <div class="carto-tool small" title="@($"Remove the area ({_context.AreaLabel}): the whole network again")" @onclick="() => Fire(NetworkSearchAction.RemoveArea)">
                    <div class=@Icons.FromString("basic:trashcan-x", IconSize.Small)></div>
                    <div class="title">No area</div>
                </div>
            }
        </div>
    }

    @if (_context.Busy)
    {
        <div class="carto-tool selected" title="@($"Cancel the search{(string.IsNullOrEmpty(_context.Progress) ? "" : $" ({_context.Progress})")}")" @onclick="() => Fire(NetworkSearchAction.Cancel)">
            <div class=@Icons.FromString("basic:round-x")></div>
            <div class="title">Cancel</div>
        </div>
    }
    else
    {
        <div class="carto-tool" title="Run the search" @onclick="Run">
            <div class=@Icons.FromString("webgis:construct-edge-intersect")></div>
            <div class="title">Run</div>
        </div>
    }


    <div class="tool-small-chunk">
        <div class="carto-tool small" title="Remove the result and the picked nodes" @onclick="() => Fire(NetworkSearchAction.Clear)">
            <div class=@Icons.FromString("basic:trashcan-x", IconSize.Small)></div>
            <div class="title">Clear</div>
        </div>
        <div class="carto-tool small" title="Select the features of the result" @onclick="() => Fire(NetworkSearchAction.ToSelection)">
            <div class=@Icons.FromString("webgis:polygon-selected", IconSize.Small)></div>
            <div class="title">Select</div>
        </div>
        <div class="carto-tool small" title="Write the result as GeoJSON into the results folder of the network" @onclick="() => Fire(NetworkSearchAction.ExportGeoJson)">
            <div class=@Icons.FromString("basic:disk-white", IconSize.Small)></div>
            <div class="title">GeoJSON</div>
        </div>
    </div>

    <MudMenu Label="Options" Dense="true">
        <div style="padding:8px;width:320px" @onclick:stopPropagation="true">
            @if (_context.NeedsStart)
            {
                <MudTextField T="string" Label="@(_context.PicksEdge ? $"{StartLabel} (Layer#OID or Layer#OID/part)" : $"{StartLabel} (Layer#OID, id, type pattern or @x,y)")" Dense="true"
                              Value="_context.Start" ValueChanged="@((string v) => { _context.Start = v; _context.StartLabel = null; Typed(_context.StartItems, v); })" />
            }
            @if (_context.NeedsTarget)
            {
                <MudTextField T="string" Label="@($"{TargetLabel} (Layer#OID, id, type pattern or @x,y; empty = module default)")" Dense="true"
                              Value="_context.Target" ValueChanged="@((string v) => { _context.Target = v; _context.TargetLabel = null; Typed(_context.TargetItems, v); })" />
            }
            @if (_context.Operation != "info")
            {
                <MudSelect T="string" Label="Tiers (empty = all)" Dense="true" Clearable="true" MultiSelection="true"
                           SelectedValues="SelectedTiers" SelectedValuesChanged="SetSelectedTiers" OpenChanged="OnTierOpenChanged">
                    @foreach (var tier in _context.Tiers)
                    {
                        <MudSelectItem Value="@tier">@tier</MudSelectItem>
                    }
                </MudSelect>
                @if (_context.Operation == "trace" && !string.IsNullOrEmpty(_context.Tier))
                {
                    <MudCheckBox T="bool" Label="Stop at the sources of the tier" Dense="true" @bind-Value="_context.StopAtSources" />
                }
            }
            @if (_context.Operation == "outage")
            {
                <MudTextField T="string" Label="@($"Sources (empty = {ModuleConfig?.SupplySources ?? "not set in the network module"})")" Dense="true" @bind-Value="_context.Sources" />
                <MudTextField T="string" Label="@($"Customers (empty = {ModuleConfig?.Customers ?? "not set in the network module"})")" Dense="true" @bind-Value="_context.Customers" />
                <MudTextField T="string" Label="Edge types (pattern, e.g. ![*,Anlagen Verbinder,*])" Dense="true" @bind-Value="_context.Filter" />
                <MudTextField T="string" Label="Blocked nodes" Dense="true" @bind-Value="_context.Block" />
            }
            @if (_context.Operation == "feeders")
            {
                <MudTextField T="string" Label="Branches (edge types at a source that start a branch, e.g. [Niederspannung,Anlagenverbinder,*]; empty = every edge)" Dense="true" @bind-Value="_context.Branches" />
                <MudCheckBox T="bool" Label="Show open edges (not gone along, at a node a branch went through)" Dense="true" @bind-Value="_context.IncludeOpen" />
                <MudSelect T="NetworkFeederColoring" Label="Colours" Dense="true" Value="_context.FeederColoring" ValueChanged="SetFeederColoring">
                    <MudSelectItem Value="NetworkFeederColoring.Branch">by branch</MudSelectItem>
                    <MudSelectItem Value="NetworkFeederColoring.Source">by source</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" Label="Palette" Dense="true" Value="_context.FeederPalette" ValueChanged="SetFeederPalette">
                    @foreach (var palette in NetworkResultLegend.FeederPalettes)
                    {
                        <MudSelectItem Value="@palette">@palette</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_context.Operation is "trace" or "reach" or "path" or "supply" or "feeders")
            {
                <MudSelect T="string" Label="Weight" Dense="true" @bind-Value="_context.Weight">
                    @foreach (var weight in _context.Weights)
                    {
                        <MudSelectItem Value="@weight">@weight</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="Max. cost" Dense="true" @bind-Value="_context.MaxCost" />
                <MudTextField T="string" Label="Edge types (pattern, e.g. ![*,Anlagen Verbinder,*])" Dense="true" @bind-Value="_context.Filter" />
                <MudTextField T="string" Label="Blocked nodes" Dense="true" @bind-Value="_context.Block" />
                <MudTextField T="string" Label="Edges switched off (Layer#OID[/part])" Dense="true" @bind-Value="_context.Disable" />
            }
            @if (_context.Operation != "validate")
            {
                <MudCheckBox T="bool" Label="GeoJSON export: snap line ends onto the nodes" Dense="true" @bind-Value="_context.SnapExport" />
            }
            @if (_context.Operation == "validate")
            {
                <MudSelect T="string" Label="Rules (empty = all rules of the map)" Dense="true" MultiSelection="true" Clearable="true"
                           SelectedValues="SelectedRules" SelectedValuesChanged="SetSelectedRules">
                    @foreach (var id in RuleList)
                    {
                        <MudSelectItem T="string" Value="@id">@id</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    </MudMenu>

    <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small" Color="@(string.IsNullOrEmpty(_context.Error) ? Color.Default : Color.Error)" OnClick="() => _showReport = !_showReport">@ReportLabel</MudButton>
    @if (_showReport)
    {
    <div style="position:fixed;right:12px;top:200px;width:460px;max-height:calc(100vh - 230px);overflow:auto;z-index:1300;padding:8px;background:var(--mud-palette-surface);box-shadow:0 4px 16px rgba(0,0,0,.35);border-radius:6px">
        <div style="text-align:right"><MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" OnClick="() => _showReport = false" title="Close" /></div>
            @if (!string.IsNullOrEmpty(_context.Error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_context.Error</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_context.Info))
            {
                <MudAlert Severity="Severity.Info" Dense="true">@_context.Info</MudAlert>
            }
            @if (_context.Busy)
            {
                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;font-size:0.8em">
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                    <span style="flex:1">@(_context.Progress ?? "running...")</span>
                    <MudButton Variant="Variant.Outlined" Size="MudBlazor.Size.Small" OnClick="() => Fire(NetworkSearchAction.Cancel)">Cancel</MudButton>
                </div>
            }
            @if (_context.Area is not null)
            {
                <div style="display:flex;align-items:center;margin-top:6px;font-size:0.8em">
                    <span style="flex:1"><b>Area</b> @_context.AreaLabel <span style="color:var(--mud-palette-text-secondary)">(only the nodes inside take part)</span></span>
                    <span style="width:22px;cursor:pointer;text-align:center" title="Zoom to the area" @onclick="() => Fire(NetworkSearchAction.ZoomToArea)">⌖</span>
                    <span style="width:22px;cursor:pointer;text-align:center" title="Remove the area" @onclick="() => Fire(NetworkSearchAction.RemoveArea)">✕</span>
                </div>
            }
            @if (_context.NeedsStart && _context.StartItems.Count > 0)
            {
                @PickedList(_context.StartItems, StartLabel, false)
            }
            @if (_context.NeedsTarget && _context.TargetItems.Count > 0)
            {
                @PickedList(_context.TargetItems, TargetLabel, true)
            }
            @if (_context.Result is NetworkQueryResult result)
            {
                <div style="display:flex;align-items:center;margin-top:6px;font-size:0.8em">
                    <b style="flex:1">Result</b>
                    <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.ContentCopy" Size="MudBlazor.Size.Small"
                                   title="@(result.Operation == "validate" ? "Copy the summary" : "Copy the text and the nodes of the result (tab separated, e.g. for Excel)")"
                                   OnClick="CopyResult" />
                </div>
                <pre style="max-height:400px;overflow:auto;font-size:0.75em;margin-top:0">@string.Join(Environment.NewLine, result.Messages)</pre>
                @if (_context.Legend is NetworkResultLegend legend && legend.Result == result)
                {
                    @Legend(legend)
                }
            }
            @if (_context.Result is NetworkQueryResult { Violations.Count: > 0 } validation)
            {
                <div style="max-height:45vh;overflow:auto;margin-top:6px">
                    <table style="width:100%;font-size:0.75em;border-collapse:collapse">
                        <tr style="text-align:left"><th>Rule</th><th>Where</th><th>Count</th><th></th></tr>
                        @for (int i = 0; i < Math.Min(validation.Violations.Count, 300); i++)
                        {
                            int index = i;
                            var violation = validation.Violations[i];
                            <tr style="cursor:pointer;border-top:1px solid var(--mud-palette-lines-default)" title="Zoom to the violation" @onclick="() => FireZoom(index)">
                                <td style="color:@(violation.Severity == "Error" ? "var(--mud-palette-error)" : "inherit")">@violation.Rule</td>
                                <td>@(violation.EdgeLabel ?? violation.NodeLabel)</td>
                                <td>@violation.Count (@violation.Min..@(violation.Max?.ToString() ?? "*"))</td>
                                <td>⌖</td>
                            </tr>
                        }
                    </table>
                    @if (validation.Violations.Count > 300)
                    {
                        <div style="font-size:0.75em">First 300 of @validation.Violations.Count violations: export GeoJSON for all.</div>
                    }
                </div>
            }
            @if (_context.Build is not null)
            {
                <div style="font-size:0.8em;margin-top:6px"><b>Build</b> @(_context.Build.Running ? "(running)" : _context.Build.Succeeded == true ? "(finished)" : "(failed)")</div>
                <pre style="max-height:200px;overflow:auto;font-size:0.75em">@string.Join(Environment.NewLine, _context.Build.Log)</pre>
            }
            @if (_context.Result is null && string.IsNullOrEmpty(_context.Error) && string.IsNullOrEmpty(_context.Info) && _context.Build is null)
            {
                <div style="font-size:0.8em">Pick a node in the map, then Run.</div>
            }
    </div>
    }
}

@code {
    private NetworkSearchContext? _context;
    private bool _showReport;

    private gView.Framework.NetworkModel.Config.NetworkConfig? ModuleConfig
        => AppScope.Modules.OfType<gView.Framework.NetworkModel.Module.NetworkModule>().FirstOrDefault(m => m.IsConfigured)?.Config;

    private IEnumerable<string> RuleList => ModuleConfig?.Rules.Select(r => r.Id) ?? [];

    private IReadOnlyCollection<string> SelectedRules
        => (_context?.RuleIds ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void SetSelectedRules(IReadOnlyCollection<string>? ids)
    {
        if (_context is not null)
        {
            _context.RuleIds = string.Join(",", ids ?? []);
        }
    }

    private IReadOnlyCollection<string> SelectedTiers
        => (_context?.Tier ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void SetSelectedTiers(IReadOnlyCollection<string>? names)
    {
        if (_context is not null)
        {
            _context.Tier = string.Join(",", names ?? []);
        }
    }

    // the network may have been built after the tool was opened: read the tiers again when the list is opened
    private Task OnTierOpenChanged(bool open) => open
        ? HandleAsync(async () => await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(NetworkSearchAction.Refresh)))
        : Task.CompletedTask;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _context = AppScope.Tools.GetCurrentToolContext<NetworkSearchContext>();
        if (_context is not null)
        {
            _context.Changed += OnContextChanged;
        }
    }

    private string StartLabel => _context?.Operation switch
    {
        "path" => "From",
        "supply" => "Sources",
        "info" => "Node",
        "outage" => "Switch off",
        "feeders" => "Sources",
        _ => "Start"
    };

    private string TargetLabel => _context?.Operation == "supply" ? "Sinks" : "To";


    private Task FireZoom(int index) => HandleAsync(async () =>
    {
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(NetworkSearchAction.ZoomToViolation, index));
    });

    private string ReportLabel
    {
        get
        {
            if (!string.IsNullOrEmpty(_context?.Error))
            {
                return "Error";
            }
            if (_context?.Result is not NetworkQueryResult result)
            {
                int picked = (_context?.StartItems.Count ?? 0) + (_context?.NeedsTarget == true ? _context.TargetItems.Count : 0);
                return picked > 0 ? $"Report ({picked} picked)" : "Report";
            }
            return result.Operation == "validate"
                ? $"Report ({result.Violations.Count} violations)"
                : $"Report ({result.Nodes.Count(n => n.AliasOf.Length == 0)} nodes, {result.Edges.Count} edges)";
        }
    }

    /// <summary>The caption of a pin button: how many are picked ("1 edge", "3 nodes"), the details are in the report.</summary>
    private static string PickedCount(List<NetworkPickedItem> items, bool edges, string empty)
        => items.Count == 0 ? empty : $"{items.Count} {(edges ? "edge" : "node")}{(items.Count == 1 ? "" : "s")}";

    private static string PickedTooltip(List<NetworkPickedItem> items)
        => items.Count == 0 ? "" : ":" + string.Concat(items.Select(i => $"\n{i.Label}"));

    /// <summary>Text typed into the field becomes the picked items, one per reference.</summary>
    private static void Typed(List<NetworkPickedItem> items, string? text)
    {
        items.Clear();
        foreach (var reference in FileNetworkGraph.SplitReferences(text ?? ""))
        {
            items.Add(new NetworkPickedItem(reference, reference));
        }
    }

    private RenderFragment PickedList(List<NetworkPickedItem> items, string title, bool target) => __builder =>
    {
        <div style="display:flex;align-items:center;margin-top:6px;font-size:0.8em">
            <b style="flex:1">@title (@items.Count)</b>
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.ContentCopy" Size="MudBlazor.Size.Small"
                           title="Copy the references (comma separated, for the field, disable= or -disable)"
                           OnClick="() => Copy(string.Join(SeparatorText, items.Select(i => i.Reference)))" />
        </div>
        <table style="width:100%;font-size:0.75em;border-collapse:collapse">
            @for (int i = 0; i < items.Count; i++)
            {
                int index = i;
                var item = items[i];
                bool zoomable = item.Reference.Contains('#') || item.Reference.StartsWith('@') || long.TryParse(item.Reference, out _);
                <tr style="border-top:1px solid var(--mud-palette-lines-default)">
                    <td style="word-break:break-word">
                        @item.Label
                        @if (item.Label != item.Reference)
                        {
                            <div style="color:var(--mud-palette-text-secondary)">@item.Reference</div>
                        }
                    </td>
                    <td style="width:22px;cursor:pointer;text-align:center" title="@(zoomable ? "Zoom to it" : "A type pattern has no single place")"
                        @onclick="() => FirePick(NetworkSearchAction.ZoomToPick, index, target)">@(zoomable ? "⌖" : "")</td>
                    <td style="width:22px;cursor:pointer;text-align:center" title="Remove"
                        @onclick="() => FirePick(NetworkSearchAction.RemovePick, index, target)">✕</td>
                </tr>
            }
        </table>
    };

    private const string SeparatorText = ", ";

    private Task FirePick(NetworkSearchAction action, int index, bool target) => HandleAsync(async () =>
    {
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(action, index, target));
    });

    /// <summary>Runs the search and shows the report with its result.</summary>
    private Task Run() => HandleAsync(async () =>
    {
        _showReport = true;
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(NetworkSearchAction.Run));
    });

    /// <summary>
    /// The result for the clipboard: the text as comment lines, then one tab separated row per node of a feature (with the
    /// merged points); validate only the text.
    /// </summary>
    private Task CopyResult()
    {
        if (_context?.Result is not NetworkQueryResult result)
        {
            return Task.CompletedTask;
        }
        var sb = new System.Text.StringBuilder();
        bool validate = result.Operation == "validate";
        foreach (var line in result.Messages)
        {
            sb.Append(validate ? "" : "# ").AppendLine(line);
        }
        if (!validate)
        {
            sb.AppendLine("label\tlayer\toid\ttype\tkind\tmerged into");
            foreach (var n in result.Nodes.Where(n => n.Layer is not null))
            {
                sb.Append(n.Label).Append('\t').Append(n.Layer).Append('\t').Append(n.Oid).Append('\t')
                  .Append(n.Type).Append('\t').Append(n.Kind).Append('\t').AppendLine(n.AliasOf);
            }
        }
        return Copy(sb.ToString());
    }

    private Task Copy(string text) => HandleAsync(async () =>
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        if (_context is not null)
        {
            _context.Info = "Copied to the clipboard.";
        }
    });

    private void OnContextChanged() => InvokeAsync(() =>
    {
        if (_context?.Notice is string notice)
        {
            _context.Notice = null;
            Snackbar.Add(notice, Severity.Info);
        }
        StateHasChanged();
    });

    #region Legend

    /// <summary>The legend rows expanded to their elements (keys).</summary>
    private readonly HashSet<string> _expanded = [];

    /// <summary>feeders: sources opened or closed by hand; the others are open when there are 5 sources at most.</summary>
    private readonly Dictionary<string, bool> _openGroups = [];

    private const int MaxListed = 200;

    private bool IsOpen(NetworkResultLegend legend, string group)
        => _openGroups.TryGetValue(group, out var open) ? open : legend.Groups.Count <= 5;

    private bool IsHidden(IEnumerable<NetworkLegendEntry> entries) => entries.All(e => _context!.HiddenKeys.Contains(e.Key));

    private static string Number(double value) => value.ToString("N0");

    private RenderFragment Legend(NetworkResultLegend legend) => __builder =>
    {
        <div style="display:flex;align-items:center;margin-top:6px;font-size:0.8em">
            <b style="flex:1">Legend</b>
            <span style="color:var(--mud-palette-text-secondary)">eye: show/hide · ⌖ zoom · select (Ctrl adds)</span>
        </div>
        <table style="width:100%;font-size:0.75em;border-collapse:collapse">
            @foreach (var entry in legend.Entries.Where(e => e.Group is null))
            {
                @LegendRow(legend, entry, entry.Key, entry.Name, [entry], 0)
            }
            @foreach (var group in legend.Groups)
            {
                var branches = legend.Entries.Where(e => e.Group == group).ToList();
                bool open = IsOpen(legend, group);
                var groupKey = NetworkResultLegend.GroupKey(group);
                <tr style="border-top:1px solid var(--mud-palette-lines-default);background:var(--mud-palette-background-gray)">
                    <td style="width:16px;cursor:pointer;text-align:center" title="@(open ? "Collapse" : "Expand")" @onclick="() => SetGroupOpen(group, !open)">@(open ? "▾" : "▸")</td>
                    <td style="width:18px">@Swatch(branches.Select(b => b.Color).Distinct().Count() == 1 ? branches[0] : null)</td>
                    <td style="word-break:break-word;cursor:pointer" @onclick="() => SetGroupOpen(group, !open)"><b>@group</b> <span style="color:var(--mud-palette-text-secondary)">(@branches.Count branch@(branches.Count == 1 ? "" : "es"))</span></td>
                    <td style="text-align:right;white-space:nowrap">@Number(branches.Sum(b => b.Count))</td>
                    <td style="text-align:right;white-space:nowrap">@Number(branches.Sum(b => b.Length)) m</td>
                    @RowActions(groupKey, branches)
                </tr>
                @if (open)
                {
                    foreach (var branch in branches)
                    {
                        @LegendRow(legend, branch, branch.Key, branch.Name, [branch], 1)
                    }
                }
            }
        </table>
    };

    private RenderFragment LegendRow(NetworkResultLegend legend, NetworkLegendEntry entry, string key, string name, IReadOnlyList<NetworkLegendEntry> entries, int indent) => __builder =>
    {
        bool expanded = _expanded.Contains(key);
        bool hidden = IsHidden(entries);
        <tr style="border-top:1px solid var(--mud-palette-lines-default);@(hidden ? "opacity:.5" : "")">
            <td style="width:16px;cursor:pointer;text-align:center" title="@(expanded ? "Hide the list" : "List them, to zoom to each")" @onclick="() => ToggleExpanded(key)">@(expanded ? "▾" : "▸")</td>
            <td style="width:18px">@Swatch(entry)</td>
            <td style="word-break:break-word;cursor:pointer;padding-left:@(indent * 12)px" @onclick="() => ToggleExpanded(key)">@name</td>
            <td style="text-align:right;white-space:nowrap">@Number(entry.Count)</td>
            <td style="text-align:right;white-space:nowrap">@(entry.Shape == NetworkLegendShape.Edge ? $"{Number(entry.Length)} m" : "")</td>
            @RowActions(key, entries)
        </tr>
        @if (expanded)
        {
            var items = legend.Items(entry);
            for (int i = 0; i < Math.Min(items.Count, MaxListed); i++)
            {
                int index = i;
                var item = items[i];
                <tr style="cursor:pointer" title="Zoom to it" @onclick="() => FireLegend(NetworkSearchAction.ZoomToElement, key, index)">
                    <td></td>
                    <td></td>
                    <td colspan="3" style="word-break:break-word;padding-left:@(indent * 12 + 8)px">
                        @item.Label <span style="color:var(--mud-palette-text-secondary)">@item.Detail</span>
                    </td>
                    <td colspan="3" style="text-align:center">⌖</td>
                </tr>
            }
            @if (items.Count > MaxListed)
            {
                <tr><td></td><td></td><td colspan="6" style="color:var(--mud-palette-text-secondary)">First @MaxListed of @items.Count: select them or export GeoJSON for all.</td></tr>
            }
        }
    };

    private RenderFragment RowActions(string key, IReadOnlyList<NetworkLegendEntry> entries) => __builder =>
    {
        bool hidden = IsHidden(entries);
        <td style="width:22px;cursor:pointer;text-align:center" title="@(hidden ? "Show in the map" : "Hide in the map")"
            @onclick="() => FireLegend(NetworkSearchAction.ToggleLegend, key)">
            <MudIcon Icon="@(hidden ? MudBlazor.Icons.Material.Filled.VisibilityOff : MudBlazor.Icons.Material.Filled.Visibility)" Size="MudBlazor.Size.Small" />
        </td>
        <td style="width:22px;cursor:pointer;text-align:center" title="Zoom to them" @onclick="() => FireLegend(NetworkSearchAction.ZoomToLegend, key)">⌖</td>
        <td style="width:22px;cursor:pointer;text-align:center" title="Select their features (replaces the selection of their layers, Ctrl adds)"
            @onclick="(MouseEventArgs e) => FireLegend(NetworkSearchAction.SelectLegend, key, add: e.CtrlKey)">
            <MudIcon Icon="@MudBlazor.Icons.Material.Filled.HighlightAlt" Size="MudBlazor.Size.Small" />
        </td>
    };

    private RenderFragment Swatch(NetworkLegendEntry? entry) => __builder =>
    {
        if (entry is null)
        {
            return;
        }
        if (entry.Shape == NetworkLegendShape.Edge)
        {
            <span style="display:inline-block;width:16px;height:0;vertical-align:middle;border-top:@(Math.Max(3, entry.Size - 1))px @(entry.Dashed ? "dashed" : "solid") @entry.CssColor"></span>
        }
        else
        {
            var size = Math.Clamp(entry.Size, 7, 13);
            <span style="display:inline-block;width:@(size)px;height:@(size)px;border-radius:50%;vertical-align:middle;background:@entry.CssColor;border:1px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.3)"></span>
        }
    };

    private void SetGroupOpen(string group, bool open) => _openGroups[group] = open;

    private void ToggleExpanded(string key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    private Task FireLegend(NetworkSearchAction action, string key, int index = 0, bool add = false) => HandleAsync(async () =>
    {
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(action, index, add, key));
    });

    private Task SetFeederColoring(NetworkFeederColoring coloring) => HandleAsync(async () =>
    {
        _context!.FeederColoring = coloring;
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(NetworkSearchAction.Redraw));
    });

    private Task SetFeederPalette(string palette) => HandleAsync(async () =>
    {
        _context!.FeederPalette = palette;
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(NetworkSearchAction.Redraw));
    });

    #endregion


    private void OperationChanged(string operation)
    {
        if (_context is null)
        {
            return;
        }
        bool pickedEdge = _context.PicksEdge;
        _context.Operation = operation;
        if (pickedEdge != _context.PicksEdge)
        {
            // an edge to switch off is no start node and the other way round
            _context.Start = _context.StartLabel = null;
            _context.StartItems.Clear();
        }
        _context.Pick = _context.NeedsStart ? NetworkSearchPick.Start : NetworkSearchPick.None;
    }

    private void SetPick(NetworkSearchPick pick)
    {
        if (_context is not null)
        {
            _context.Pick = pick;
        }
    }

    private Task Fire(NetworkSearchAction action) => HandleAsync(async () =>
    {
        await EventBus.FireToolEventAsync(new NetworkSearchEventArgs(action));
    });

    public void Dispose()
    {
        if (_context is not null)
        {
            _context.Changed -= OnContextChanged;
        }
    }
}
