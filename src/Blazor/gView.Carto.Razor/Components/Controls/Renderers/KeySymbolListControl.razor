@using gView.Carto.Razor.Components.Controls.Renderers.Models

@inject ICartoDocumentService CartoDocument
@inject IDialogService MessageDialogs
@inherits BaseHandler
@typeparam TKey

@if (KeySymbols is not null)
{
    <MudDropContainer T="KeySymbol<TKey>"
                      Items="KeySymbols.Take(1000)"
                      ItemDropped="ReorderItems"
                      ItemDisabled="@(item => IsComposing(item.Key))"
                      DisabledClass=""
                      ItemsSelector="@((item,zone) => true)">
        <ChildContent>
                <div style="height:63vh;overflow-y:auto;overflow-x:hidden;white-space:nowrap">
                    <MudDropZone T="KeySymbol<TKey>"
                                 AllowReorder="AllowReorder">
                        @if (ListItemTools is not null)
                        {
                            @ListItemTools
                        }
                        @if (SelectedKeys is not null && KeySymbols.Count > 0)
                        {
                            <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap">
                                <MudText Typo="Typo.body2" Class="me-2">
                                    @($"{SelectedKeysCount()} selected")
                                </MudText>
                                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="SelectAll">All</MudButton>
                                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="SelectNone">None</MudButton>
                                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="InvertSelection">Invert</MudButton>
                                @if (Counts is not null)
                                {
                                    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                                               title="Select all classes without features"
                                               OnClick="SelectEmpty">Select empty</MudButton>
                                }
                                <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Outlined.Delete"
                                           Disabled="@(SelectedKeysCount() == 0)"
                                           OnClick="RemoveSelected">Remove selected</MudButton>
                            </div>
                        }
                        @if (KeySymbols.Count > 1000)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @($"Only the first 1000 of {KeySymbols.Count} classes are listed.")
                            </MudAlert>
                        }
                    </MudDropZone>
                </div>
        </ChildContent>
        <ItemRenderer>
            <div style="@RowStyle(context.Key)">
            <div style="@EmptyStyle(context.Key)">
            <GvGrid ColumnCount="12">
                @if (SelectedKeys is not null)
                {
                    <GvGridItem Span="1">
                        <MudIconButton Icon="@(IsSelected(context.Key) ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                       OnClick="(e) => ToggleSelection(context.Key, e)"
                                       Size="MudBlazor.Size.Small"
                                       Color="@(IsSelected(context.Key) ? Color.Primary : Color.Default)"
                                       title="Select (Shift: select range)"
                                       aria-label="select"></MudIconButton>
                    </GvGridItem>
                }
                <GvGridItem Span="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   OnClick="() => DeleteItem(context)"
                                   Size="MudBlazor.Size.Small"
                                   Color="Color.Secondary"
                                   aria-label="delete"></MudIconButton>
                </GvGridItem>
                <GvGridItem Span="1">
                    <div style="display:inline-block;width:30px;height:30px;cursor:pointer;background-image:url('@context.Symbol.ToBase64ImageSource(CartoDocument.CurrentMap, 30,30)')"
                         title="@(IsComposing(context.Key) ? "Close symbol editor" : "Edit symbol")"
                         @onclick="() => ComposeSymbol(context.Key)">
                    </div>
                </GvGridItem>
                <GvGridItem Span="4">
                    <div style="overflow:hidden">
                        @context.Key
                    </div>
                </GvGridItem>
                <GvGridItem Span="@(LabelSpan)">
                    @if (_editLabelKey is not null && _editLabelKey.Equals(context.Key))
                    {
                        <InlineInput @bind-Value="@context.LegendLabel"
                                     OnCommit="OnLegendItemChanged"/>
                    }
                    else
                    {
                        <div @onclick="() => _editLabelKey = context.Key"
                             style="cursor:text"
                             title="Click to edit the legend label">
                            @context.LegendLabel
                        </div>
                    }
                </GvGridItem>
                @if (Counts is not null)
                {
                    <GvGridItem Span="1">
                        <div style="text-align:right;padding-right:8px;opacity:.8" title="Number of features">
                            @(Counts.TryGetValue(context.Key, out long count) ? count.ToString("N0") : "")
                        </div>
                    </GvGridItem>
                }
            </GvGrid>
            </div>
            @if (IsComposing(context.Key))
            {
                int selectedOthers = SelectedOtherCount(context.Key);
                var composeKey = context.Key;
                var composeSymbol = context.Symbol;

                <div style="white-space:normal;padding:0 8px 8px 8px">
                    <div style="display:flex;align-items:flex-start;gap:4px">
                        <div style="flex:1;min-width:0">
                            <QuickSymbolPropertiesControl @key="composeSymbol"
                                                          Symbol="composeSymbol"
                                                          SymbolChanged="(symbol) => OnSymbolChanged(composeKey, symbol)" />
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="MudBlazor.Size.Small"
                                       title="Close symbol editor"
                                       OnClick="CloseComposer" />
                    </div>
                    <MudMenu Label="Apply to ..." Variant="Variant.Outlined" Size="MudBlazor.Size.Small" Color="Color.Primary">
                        @if (selectedOthers > 0)
                        {
                            <MudMenuItem OnClick="() => ApplyComposedSymbolAsync(composeKey, keepColors: false)">
                                @($"{selectedOthers} selected classes")
                            </MudMenuItem>
                            <MudMenuItem OnClick="() => ApplyComposedSymbolAsync(composeKey, keepColors: true)"
                                         Disabled="@(!composeSymbol.CanBulkEdit())">
                                @($"{selectedOthers} selected classes, keep colors")
                            </MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem OnClick="() => ApplyComposedSymbolAsync(composeKey, keepColors: false)">
                                All classes
                            </MudMenuItem>
                            <MudMenuItem OnClick="() => ApplyComposedSymbolAsync(composeKey, keepColors: true)"
                                         Disabled="@(!composeSymbol.CanBulkEdit())">
                                All classes, keep colors
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            }
            </div>
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    [Parameter] public RenderFragment? ListItemTools { get; set; }
    [Parameter] public bool AllowReorder { get; set; } = true;
    [Parameter] public List<KeySymbol<TKey>>? KeySymbols { get; set; }
    [Parameter] public EventCallback<KeySymbol<TKey>> OnKeySymbolChanged { get; set; }
    [Parameter] public EventCallback<List<KeySymbol<TKey>>> OnKeySymbolsChanged { get; set; }

    /// <summary>
    /// The selected keys (owned by the page). If null, the list has no selection column.
    /// </summary>
    [Parameter] public HashSet<TKey>? SelectedKeys { get; set; }
    [Parameter] public EventCallback OnSelectionChanged { get; set; }
    /// <summary>
    /// Identifies the "all other values" class: "Apply to all classes" leaves it out.
    /// </summary>
    [Parameter] public Func<TKey, bool>? IsAllOtherValues { get; set; }
    /// <summary>
    /// Number of features per class (if counted). Shows a count column; classes with 0 are greyed.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<TKey, long>? Counts { get; set; }

    private int LabelSpan => 6 - (SelectedKeys is not null ? 1 : 0) - (Counts is not null ? 1 : 0);

    private string EmptyStyle(TKey key)
        => Counts is not null && Counts.TryGetValue(key, out long count) && count == 0
            ? "opacity:.45"
            : "";

    private TKey? _composeSymbolKey = default;
    private TKey? _editLabelKey = default;
    private int _lastToggledIndex = -1;

    protected override Task OnParametersSetAsync()
    {
        // the edited class is gone (deleted, other value field, ...) => close the editor
        if (_composeSymbolKey is not null
            && KeySymbols?.Any(k => _composeSymbolKey.Equals(k.Key)) != true)
        {
            _composeSymbolKey = default;
        }

        return base.OnParametersSetAsync();
    }

    private bool IsComposing(TKey key)
        => _composeSymbolKey is not null && _composeSymbolKey.Equals(key);

    /// <summary>
    /// Opens the inline symbol editor below the class (a second click closes it). Only one is open.
    /// </summary>
    private void ComposeSymbol(TKey key)
    {
        _composeSymbolKey = IsComposing(key) ? default : key;

        StateHasChanged();
    }

    private void CloseComposer() => _composeSymbolKey = default;

    private string RowStyle(TKey key)
        => IsComposing(key)
            ? "background:var(--mud-palette-action-default-hover);border-left:3px solid var(--mud-palette-primary);border-radius:4px;margin:2px 0"
            : "";

    private Task OnSymbolChanged(TKey key, ISymbol newSymbol) => HandleAsync(async () =>
    {
        if (KeySymbols is not null)
        {
            var keySymbol = KeySymbols?.FirstOrDefault(k => k.Key?.Equals(key) == true);

            if(keySymbol is not null)
            {
                var oldSymbol = keySymbol.Symbol as ILegendItem;
                if(oldSymbol is not null && newSymbol is ILegendItem legendItem)
                {
                    legendItem.LegendLabel = oldSymbol.LegendLabel;
                }

                keySymbol.Symbol = newSymbol;

                await OnKeySymbolsChanged.InvokeAsync(KeySymbols);
            }
        }
    });

    private Task OnLegendItemChanged() => HandleAsync(() =>
    {
        if (_editLabelKey is not null && KeySymbols is not null)
        {
            var keySymbol = KeySymbols?.FirstOrDefault(k => k.Key?.Equals(_editLabelKey) == true);
            _editLabelKey = default(TKey);

            return OnKeySymbolChanged.InvokeAsync(keySymbol);
        }

        return Task.CompletedTask;
    });

    private Task DeleteItem(KeySymbol<TKey> keySymbol) => HandleAsync(async () =>
    {
        KeySymbols?.Remove(keySymbol);

        if (SelectedKeys?.Remove(keySymbol.Key) == true)
        {
            await OnSelectionChanged.InvokeAsync();
        }

        await OnKeySymbolsChanged.InvokeAsync(KeySymbols);
    });

    async Task ReorderItems(MudItemDropInfo<KeySymbol<TKey>> dropInfo)
    {
        if(AllowReorder == false || KeySymbols is null || dropInfo.Item is null)
        {
            return;
        }

        //
        // Completely rebuild a new list
        // with new instances of items (.Copy())
        // otherwise the list will not refreshed correctly
        // in the dropzone
        //
        var keySymbols = KeySymbols;
        KeySymbols = new();

        bool added = false;
        foreach(var item in keySymbols)
        {
            if(KeySymbols.Count == dropInfo.IndexInZone)
            {
                KeySymbols.Add(dropInfo.Item.Copy());
                added = true;
            }
            if(item == dropInfo.Item)
            {
                continue;
            }

            KeySymbols.Add(item.Copy());
        }
        if(!added)
        {
            KeySymbols.Add(dropInfo.Item.Copy());
        }

        await OnKeySymbolsChanged.InvokeAsync(KeySymbols);

        StateHasChanged();
    }

    #region Selection

    private bool IsSelected(TKey key) => SelectedKeys?.Contains(key) == true;

    private int SelectedKeysCount()
        => KeySymbols?.SelectedKeySymbols(SelectedKeys).Length ?? 0;

    private int SelectedOtherCount(TKey key)
        => KeySymbols?.SelectedKeySymbols(SelectedKeys).Count(k => !Equals(k.Key, key)) ?? 0;

    private Task ToggleSelection(TKey key, MouseEventArgs e) => HandleAsync(async () =>
    {
        if (SelectedKeys is null || KeySymbols is null)
        {
            return;
        }

        int index = KeySymbols.FindIndex(k => Equals(k.Key, key));
        bool select = !SelectedKeys.Contains(key);

        if (e.ShiftKey && _lastToggledIndex >= 0 && _lastToggledIndex < KeySymbols.Count && index >= 0)
        {
            int from = Math.Min(_lastToggledIndex, index), to = Math.Max(_lastToggledIndex, index);
            foreach (var keySymbol in KeySymbols.Skip(from).Take(to - from + 1))
            {
                if (select)
                {
                    SelectedKeys.Add(keySymbol.Key);
                }
                else
                {
                    SelectedKeys.Remove(keySymbol.Key);
                }
            }
        }
        else if (select)
        {
            SelectedKeys.Add(key);
        }
        else
        {
            SelectedKeys.Remove(key);
        }

        _lastToggledIndex = index;
        await OnSelectionChanged.InvokeAsync();
    });

    private Task SelectAll() => ChangeSelection(keys =>
    {
        keys.Clear();
        keys.UnionWith(KeySymbols!.Select(k => k.Key));
    });

    private Task SelectEmpty() => ChangeSelection(keys =>
    {
        keys.Clear();
        keys.UnionWith(KeySymbols!
                        .Where(k => Counts?.TryGetValue(k.Key, out long count) == true && count == 0)
                        .Select(k => k.Key));
    });

    private Task SelectNone() => ChangeSelection(keys => keys.Clear());

    private Task InvertSelection() => ChangeSelection(keys =>
    {
        var inverted = KeySymbols!.Select(k => k.Key).Where(k => !keys.Contains(k)).ToArray();
        keys.Clear();
        keys.UnionWith(inverted);
    });

    private Task ChangeSelection(Action<HashSet<TKey>> change) => HandleAsync(async () =>
    {
        if (SelectedKeys is null || KeySymbols is null)
        {
            return;
        }

        change(SelectedKeys);
        _lastToggledIndex = -1;

        await OnSelectionChanged.InvokeAsync();
    });

    private Task RemoveSelected() => HandleAsync(async () =>
    {
        if (SelectedKeys is null || KeySymbols is null)
        {
            return;
        }

        foreach (var keySymbol in KeySymbols.SelectedKeySymbols(SelectedKeys))
        {
            KeySymbols.Remove(keySymbol);
            keySymbol.Symbol?.Release();
        }
        SelectedKeys.Clear();
        _lastToggledIndex = -1;

        KeySymbols = KeySymbols.Select(k => k.Copy()).ToList();

        await OnSelectionChanged.InvokeAsync();
        await OnKeySymbolsChanged.InvokeAsync(KeySymbols);
    });

    private Task ApplyComposedSymbolAsync(TKey sourceKey, bool keepColors) => HandleAsync(async () =>
    {
        if (KeySymbols is null)
        {
            return;
        }

        var template = KeySymbols.First(k => Equals(k.Key, sourceKey)).Symbol;
        var selected = KeySymbols.SelectedKeySymbols(SelectedKeys);
        var targets = (selected.Length > 0
                        ? selected
                        : KeySymbols.Where(k => IsAllOtherValues?.Invoke(k.Key) != true))
                      .Where(k => !Equals(k.Key, sourceKey))
                      .ToArray();

        KeySymbols = KeySymbols.PasteSymbol(template, targets, keepColors, out int noColorCount);

        await OnKeySymbolsChanged.InvokeAsync(KeySymbols);

        if (noColorCount > 0)
        {
            await MessageDialogs.ShowMessageBoxAsync("Apply symbol",
                $"{noColorCount} class(es) had no color to keep (complex symbol) and got the colors of the template.");
        }
    });

    #endregion
}
