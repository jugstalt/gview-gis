@using gView.Carto.Razor.Components.Controls.Renderers.Models
@using gView.Framework.Core.Data.Cursors
@using gView.Framework.Data.Filters
@using gView.Framework.Cartography.Rendering.Classification
@using gView.Framework.Symbology.Palettes

@inherits BaseHandler
@implements IDisposable

@inject IApplicationScopeFactory AppScopeFactory
@inject ISymbolClipboard SymbolClipboard
@inject IDialogService MessageDialogs

@if (_renderer is not null && _layer?.FeatureClass is not null)
{
    <KeySymbolListControl TKey="RangeClass"
                          KeySymbols="@(CurrentKeySymbolsList() ?? [])"
                          AllowReorder="false"
                          OnKeySymbolsChanged="SymbolsListChanged"
                          OnKeySymbolChanged="SymbolChanged"
                          SelectedKeys="_selectedKeys"
                          Counts="_counts"
                          UndoAction="@_undo.NextAction"
                          OnUndo="OnUndo"
                          OnBeforeChange="PushUndo"
                          OnSelectionChanged="StateHasChanged">
        <ListItemTools>
            @if(_addQuantityItem is null && _wizardModel is null) 
            {
                <GvGrid ColumnCount="2">
                    <GvGridItem>
                        <MudSelect T="string" Label="Value Field"
                                   Value="_renderer.ValueField"
                                   ValueChanged="(val) => OnValueFieldChanged(val)">
                            @GvUtilities.StringsToSelectItems(_layer.FeatureClass.Fields?
                                        .ToEnumerable()
                                        .Where(f => f.type switch
                                         {
                                             Framework.Core.Data.FieldType.ID => true,
                                             Framework.Core.Data.FieldType.Float => true,
                                             Framework.Core.Data.FieldType.Double => true,
                                             Framework.Core.Data.FieldType.smallinteger => true,
                                             Framework.Core.Data.FieldType.integer => true,
                                             Framework.Core.Data.FieldType.biginteger => true,
                                             _ => false
                                         })
                                         .Select(f => f.name) ?? [])
                        </MudSelect>
                    </GvGridItem>
                    <GvGridItem>

                    </GvGridItem>
                </GvGrid>
                <MudPaper Elevation="24">
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                        <MudButton OnClick="OnShowWizard">Wizard</MudButton>
                        <MudButton OnClick="() => _addQuantityItem = new()">Add Value</MudButton>
                        <MudMenu Label="More ..." Variant="Variant.Filled">
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.Numbers"
                                         IconColor="Color.Primary"
                                         OnClick="OnCountFeaturesClickAsync">
                                Count Features
                            </MudMenuItem>
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.Palette"
                                         IconColor="Color.Primary"
                                         OnClick="OnRecolorClickAsync">
                                Recolor ...
                            </MudMenuItem>
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.Tune"
                                         IconColor="Color.Primary"
                                         OnClick="OnSetSymbolPropertiesClickAsync">
                                Set Symbol Properties ...
                            </MudMenuItem>
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.ContentPaste"
                                         IconColor="Color.Primary"
                                         Disabled="@(!CanPasteSymbol())"
                                         OnClick="() => OnPasteSymbolClickAsync(keepColors: false)">
                                Paste Symbol
                            </MudMenuItem>
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Outlined.ContentPasteGo"
                                         IconColor="Color.Primary"
                                         Disabled="@(!CanPasteSymbol(keepColors: true))"
                                         OnClick="() => OnPasteSymbolClickAsync(keepColors: true)">
                                Paste Symbol, keep colors
                            </MudMenuItem>
                            <MudMenuItem Icon="@MudBlazor.Icons.Material.Filled.Delete"
                                         IconColor="Color.Secondary"
                                         OnClick="OnRemoveAllMenuClick">
                                Remove All
                            </MudMenuItem>
                        </MudMenu>
                    </MudButtonGroup>
                </MudPaper>
                <MudText Typo="Typo.h6">
                    @($"{_dictKeySymbols.IfKeyExists(_renderer.ValueField, (l) => l.Count)} items")
                </MudText>
            }
            else if (_addQuantityItem is not null)
            {
                <GvCard Title="Add Value Item">
                    <GvCardContent>
                        <GvGrid ColumnCount="2">
                            <GvGridItem>
                                <MudNumericField Label="Min Value"
                                                 @bind-Value="_addQuantityItem.Min"></MudNumericField>
                                <MudNumericField Label="Max Value"
                                                 @bind-Value="_addQuantityItem.Max"></MudNumericField>
                            </GvGridItem>
                            <GvGridItem>
                                <MudTextField Label="Label Text"
                                              @bind-Value="_addQuantityItem.LabelText"></MudTextField>
                            </GvGridItem>
                        </GvGrid>
                    </GvCardContent>
                    <GvCardActions>
                        <MudButton Variant="Variant.Filled"
                                   OnClick="() => _addQuantityItem = null">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="OnAddValueItem">Add</MudButton>
                    </GvCardActions>
                </GvCard>
            }
            else if(_wizardModel is not null)
            {
                <GvCard Title="Wizard">
                    <GvCardContent>
                        <GvGrid ColumnCount="2">
                            <GvGridItem>
                                <MudNumericField @bind-Value="_wizardModel.MinValue"
                                                 Label="Minimum Value"></MudNumericField>
                            </GvGridItem>
                            <GvGridItem>
                                <QuickSymbolPropertiesControl Symbol="_wizardModel.MinValueSymbol"
                                                              ShowPropertyGrid="false"
                                                              SymbolChanged="(sym) => _wizardModel.MinValueSymbol = sym" />
                            </GvGridItem>

                            <GvGridItem>
                                <MudNumericField @bind-Value="_wizardModel.MaxValue"
                                                 Label="Maximum Value"></MudNumericField>
                            </GvGridItem>
                            <GvGridItem>
                                @if (_wizardModel.Colors == QuantityWizardColors.MinMaxSymbol)
                                {
                                    <QuickSymbolPropertiesControl Symbol="_wizardModel.MaxValueSymbol"
                                                                  ShowPropertyGrid="false"
                                                                  SymbolChanged="(sym) => _wizardModel.MaxValueSymbol = sym" />
                                }
                            </GvGridItem>

                            <GvGridItem>
                                <MudSelect T="ClassificationMethod" Label="Method"
                                           PopoverClass="gv-dialog-popover"
                                           @bind-Value="_wizardModel.Method">
                                    <MudSelectItem Value="ClassificationMethod.EqualInterval">Equal Interval</MudSelectItem>
                                    <MudSelectItem Value="ClassificationMethod.Quantile">Quantile (same number of features)</MudSelectItem>
                                    <MudSelectItem Value="ClassificationMethod.NaturalBreaks">Natural Breaks (Jenks)</MudSelectItem>
                                </MudSelect>
                            </GvGridItem>
                            <GvGridItem>
                                @if (_wizardModel.Method == ClassificationMethod.EqualInterval)
                                {
                                    <MudRadioGroup @bind-Value="_wizardModel.FixStepMethod">
                                        <MudRadio Value="StepMethod.FixCount">
                                            <MudNumericField @bind-Value="_wizardModel.FixStepCount"
                                                             Label="Number of classes" Min="1" />
                                        </MudRadio>
                                        <MudRadio Value="StepMethod.FixWidth">
                                            <MudNumericField @bind-Value="_wizardModel.FixStepWidth"
                                                             Label="Step width" />
                                        </MudRadio>
                                    </MudRadioGroup>
                                }
                                else
                                {
                                    <MudNumericField @bind-Value="_wizardModel.FixStepCount"
                                                     Label="Number of classes" Min="1" Max="50" />
                                }
                            </GvGridItem>

                            <GvGridItem>
                                <MudSelect T="QuantityWizardColors" Label="Colors"
                                           PopoverClass="gv-dialog-popover"
                                           @bind-Value="_wizardModel.Colors">
                                    <MudSelectItem Value="QuantityWizardColors.MinMaxSymbol">Minimum to maximum symbol</MudSelectItem>
                                    <MudSelectItem Value="QuantityWizardColors.Palette">Palette (style of the minimum symbol)</MudSelectItem>
                                </MudSelect>
                            </GvGridItem>
                            <GvGridItem>
                                @if (_wizardModel.Colors == QuantityWizardColors.Palette)
                                {
                                    <MudSelect T="string" Label="Palette"
                                               PopoverClass="gv-dialog-popover"
                                               @bind-Value="_wizardModel.PaletteName">
                                        @foreach (var palette in ColorPalettes.All)
                                        {
                                            <MudSelectItem Value="palette.Name">
                                                <div style="display:flex;align-items:center;gap:12px">
                                                    <div style="@PaletteBarStyle(palette)"></div>
                                                    <span>@palette.Name</span>
                                                </div>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudCheckBox T="bool" Label="Reverse" @bind-Value="_wizardModel.Reverse" />
                                }
                            </GvGridItem>

                            <GvGridItem>
                                <MudNumericField @bind-Value="_wizardModel.Decimals"
                                                 Label="Decimals (limits and labels)" Min="0" Max="10" />
                            </GvGridItem>
                        </GvGrid>
                    </GvCardContent>
                    <GvCardActions>
                        <MudButton Variant="Variant.Filled"
                                   OnClick="() => _wizardModel = null">Close</MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="_processingWizard"
                                   OnClick="OnWizardCreateLegendItemsAsync">
                            @(_processingWizard ? "Reading values ..." : "Create Legend Items")
                        </MudButton>
                    </GvCardActions>
                </GvCard>
            }
        </ListItemTools>
    </KeySymbolListControl>

    <MudPaper Elevation="24">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
            <MudButton OnClick="SetRotation"
                       Disabled="@(!_layer.CanRotateSymbols())">
                Rotation
            </MudButton>

            @* <MudButton OnClick="SetCartographicsMethod"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Cartography
            </MudButton> *@
        </MudButtonGroup>
    </MudPaper>
}

@code {
    [Parameter] public object? Instance { get; set; }

    private IFeatureLayer? _layer;
    private QuantityRenderer? _renderer;

    private Dictionary<string, List<KeySymbol<RangeClass>>> _dictKeySymbols = new();
    private HashSet<RangeClass> _selectedKeys = new();
    private Dictionary<RangeClass, long>? _counts = null;
    private readonly KeySymbolUndoStack<RangeClass> _undo = new();
    private QuantityItemModel? _addQuantityItem = null;
    private QuantityWizardModel? _wizardModel = null;

    protected override Task OnParametersSetAsync() => HandleAsync(async () =>
    {
        await base.OnParametersSetAsync();

        if (Instance is IFeatureLayer fLayer)
        {
            _layer = fLayer;
            _renderer = fLayer.FeatureRenderer as QuantityRenderer;

            if (_renderer is not null)
            {
                _renderer.GeometryType = _layer.LayerGeometryType;
                if (String.IsNullOrEmpty(_renderer.ValueField))
                {
                    _renderer.ValueField = _layer.FeatureClass?.IDFieldName ?? "";
                }
            }
        }
        else
        {
            _renderer = Instance as QuantityRenderer;
        }

        if (_renderer is not null)
        {
            var keySymbols = CurrentKeySymbolsList();
            keySymbols.Clear();

            int index = 0;
            foreach (var quantityClass in _renderer.QuantityClasses)
            {
                var symbol = quantityClass.Symbol?.Clone() as ISymbol;

                if (symbol is not null)
                {
                    keySymbols.Add(new KeySymbol<RangeClass>(
                        new RangeClass(quantityClass.Min, quantityClass.Max), symbol));
                }
                index++;
            }
        }
    });

    private void ApplyChanges()
    {
        if (_renderer is null)
        {
            return;
        }

        _renderer.QuantityClasses
                 .ForEach(qClass => _renderer.RemoveClass(qClass));

        var keySymbols = CurrentKeySymbolsList();
        keySymbols.ForEach((keySymbol) 
             => _renderer.AddClass(
                     new QuantityRenderer.QuantityClass(
                        keySymbol.Key.Min,
                        keySymbol.Key.Max,
                        keySymbol.Symbol.Clone() as ISymbol
                     )
                 )
            );
    }

    private void SymbolsListChanged(List<KeySymbol<RangeClass>> keySymbols)
    {
        if (_renderer is null)
        {
            return;
        }

        _dictKeySymbols[_renderer.ValueField] = keySymbols;
        ApplyChanges();
    }

    private void SymbolChanged(KeySymbol<RangeClass> keySymbol)
    {
        if (_renderer is null)
        {
            return;
        }

        ApplyChanges();
    }

    private void OnValueFieldChanged(string field)
    {
        _selectedKeys.Clear();
        _counts = null;
        _undo.Clear();

        if (_renderer is not null)
        {
            _renderer.ValueField = field;

            CurrentKeySymbolsList();
        }
    }

    #region Button Events

    /// <summary>
    /// Creates an undo point (copy of the current classes) before a change.
    /// </summary>
    private void PushUndo(string action)
        => _undo.Push(action, CurrentKeySymbolsList(), _counts);

    private void OnUndo() => Handle(() =>
    {
        if (_renderer is null)
        {
            return;
        }

        var entry = _undo.Pop();
        if (entry is null)
        {
            return;
        }

        CurrentKeySymbolsList().ForEach(k => k.Symbol?.Release());
        _dictKeySymbols[_renderer.ValueField] = entry.KeySymbols;
        _counts = entry.Counts;

        ApplyChanges();
    });

    private void OnRemoveAllMenuClick()
    {
        PushUndo("Remove All");
        OnRemoveAllItems();
    }


    private Task OnCountFeaturesClickAsync() => HandleAsync(async () =>
    {
        if (_renderer is null || _layer?.FeatureClass is null)
        {
            return;
        }

        var keySymbols = CurrentKeySymbolsList();
        var counts = await _layer.CountByRangesAsync(
            _renderer.ValueField,
            keySymbols.Select(k => (k.Key.Min, k.Key.Max)).ToArray());

        _counts = keySymbols
            .Select((k, i) => (k.Key, Count: counts[i]))
            .ToDictionary(k => k.Key, k => k.Count);
    });


    private bool CanPasteSymbol(bool keepColors = false)
        => _layer is not null
           && SymbolClipboard.CanPaste(_layer.LayerGeometryType)
           && (!keepColors || SymbolClipboard.Symbol.CanBulkEdit());

    private Task OnPasteSymbolClickAsync(bool keepColors) => HandleAsync(async () =>
    {
        if (_renderer is null || SymbolClipboard.Symbol is null || !CanPasteSymbol(keepColors))
        {
            return;
        }

        var keySymbols = CurrentKeySymbolsList();
        var selected = keySymbols.SelectedKeySymbols(_selectedKeys);
        var targets = selected.Length > 0
            ? selected
            : keySymbols.ToArray();

        PushUndo(keepColors ? "Paste Symbol, keep colors" : "Paste Symbol");
        _dictKeySymbols[_renderer.ValueField] = keySymbols.PasteSymbol(SymbolClipboard.Symbol, targets, keepColors, out int noColorCount);
        ApplyChanges();

        if (noColorCount > 0)
        {
            await MessageDialogs.ShowMessageBoxAsync("Paste Symbol",
                $"{noColorCount} class(es) had no color to keep (complex symbol) and got the colors of the pasted symbol.");
        }
    });


    private Task OnRecolorClickAsync() => HandleAsync(async () =>
    {
        if (_renderer is null || _layer is null)
        {
            return;
        }

        var keySymbols = await CurrentKeySymbolsList().RecolorAsync(AppScopeFactory, _layer.LayerGeometryType, null, _selectedKeys, () => PushUndo("Recolor"));

        if (keySymbols is not null)
        {
            _dictKeySymbols[_renderer.ValueField] = keySymbols;
            ApplyChanges();
        }
    });

    private Task OnSetSymbolPropertiesClickAsync() => HandleAsync(async () =>
    {
        if (_renderer is null || _layer is null)
        {
            return;
        }

        var keySymbols = await CurrentKeySymbolsList().SetSymbolPropertiesAsync(AppScopeFactory, _layer.LayerGeometryType, null, _selectedKeys, () => PushUndo("Set Symbol Properties"));

        if (keySymbols is not null)
        {
            _dictKeySymbols[_renderer.ValueField] = keySymbols;
            ApplyChanges();
        }
    });


    private Task OnShowWizard() => HandleAsync(async () =>
    {
        if(_renderer is null || _layer is null)
        {
            return;
        }

        _wizardModel = await QuantityWizardModel.CreateAsync(_renderer, _layer);
    });

    private void OnRemoveAllItems() => Handle(() =>
    {
        if (_renderer is null)
        {
            return;
        }

        _dictKeySymbols.RemoveIfExists(_renderer.ValueField, (keySymbols) =>
            keySymbols?.ForEach((keySymbol)
                => keySymbol.Symbol?.Release())
        );

        CurrentKeySymbolsList();

        ApplyChanges();
    });

    private void OnAddAllOtherValuesItem() => Handle(() =>
    {
        // if (_renderer is null)
        // {
        //     return;
        // }

        // var keySymbols = CurrentKeySymbolsList();

        // keySymbols.Any(k => k.Key == ValueMapRenderer.AllOtherValuesKey)
        //           .ThrowIfTrue(() => "All other values item is already added");

        // var symbol = RendererFunctions.CreateStandardSymbol(_renderer.GeometryType)
        //                           .AddLegendLabel(ValueMapRenderer.AllOtherValuesLabel);

        // keySymbols.Add(new KeySymbol(ValueMapRenderer.AllOtherValuesKey, symbol));

        // ApplyChanges();

    });

    private void OnAddValueItem() => Handle(() =>
    {
        if (_renderer is not null
            && _layer is not null
            && _addQuantityItem is not null)
        {
            var keySymbols = CurrentKeySymbolsList();

            var rangeClass = new RangeClass(_addQuantityItem.Min, _addQuantityItem.Max);
            if (rangeClass.Overlaps(keySymbols.Select(keySymbol => keySymbol.Key)))
            {
                throw new ArgumentException("Overlapping ranges are not allowed!");
            }

            var symbol = RendererFunctions
                            .CreateStandardSymbol(_layer.LayerGeometryType)
                            .ThrowIfNull(() => $"Can't create a symbol for {_layer.LayerGeometryType} geometry")
                            .AddLegendLabel(_addQuantityItem.LabelText);

            keySymbols.Add(new KeySymbol<RangeClass>(rangeClass, symbol));

            ApplyChanges();
        }
        _addQuantityItem = null;
    });

    private Task OnWizardSmbolChanged(QuantityWizardSymbol sym) => HandleAsync(async () =>
    {
        if (_wizardModel is not null && _wizardModel[sym] is not null)
        {
            var newSymbol = await _wizardModel[sym]!.Compose(AppScopeFactory);

            if (newSymbol != _wizardModel[sym])
            {
                _wizardModel[sym] = newSymbol;
            }
        }
    });

    private bool _processingWizard = false;

    private static string PaletteBarStyle(ColorPalette palette)
        => $"background:{palette.Colors.ToCssLinearGradient(palette.Type == ColorPaletteType.Qualitative)};height:16px;width:100px;border-radius:4px;flex-shrink:0";

    private Task OnWizardCreateLegendItemsAsync() => HandleAsync(async () =>
    {
        if (_wizardModel is null || _renderer is null || _layer is null)
        {
            return;
        }

        try
        {
            _processingWizard = true;
            await ForceRenderComponent();

            var wizard = _wizardModel;
            var values = await _layer.ReadNumericValuesAsync(_renderer.ValueField);
            values.Sort();

            double min = wizard.MinValue, max = wizard.MaxValue;
            var inRange = values.Where(v => v >= min && v <= max).ToArray();

            double[] limits = wizard.Method switch
            {
                ClassificationMethod.Quantile => ClassBreaks.Quantile(inRange, wizard.FixStepCount),
                ClassificationMethod.NaturalBreaks => ClassBreaks.NaturalBreaks(inRange, wizard.FixStepCount),
                _ => wizard.FixStepMethod == StepMethod.FixWidth
                        ? ClassBreaks.EqualIntervalByWidth(min, max, wizard.FixStepWidth)
                        : ClassBreaks.EqualInterval(min, max, wizard.FixStepCount)
            };
            limits = ClassBreaks.Round(limits, wizard.Decimals);

            if (limits.Length < 2)
            {
                throw new ArgumentException("No classes: the value range is empty (minimum = maximum or no values in the range)");
            }

            var ranges = limits.Zip(limits.Skip(1)).Select(l => (Min: l.First, Max: l.Second)).ToArray();
            var colors = wizard.Colors == QuantityWizardColors.Palette
                ? (ColorPalettes.Find(wizard.PaletteName) ?? ColorPalettes.All[0]).GetColors(ranges.Length, wizard.Reverse)
                : null;

            PushUndo("Wizard");
            OnRemoveAllItems();
            var keySymbols = CurrentKeySymbolsList();

            for (int i = 0; i < ranges.Length; i++)
            {
                ISymbol? symbol = colors is not null
                    ? wizard.MinValueSymbol?.Clone() as ISymbol
                    : AlternateSymbol(wizard.MinValueSymbol!, wizard.MaxValueSymbol!,
                                      ranges.Length == 1 ? 0f : (float)i / (ranges.Length - 1));
                if (symbol is null)
                {
                    continue;
                }

                if (colors is not null)
                {
                    symbol.ApplyColor(colors[i]);
                }

                symbol.AddLegendLabel(ClassBreaks.Label(ranges[i].Min, ranges[i].Max, wizard.Decimals));
                keySymbols.Add(new KeySymbol<RangeClass>(new RangeClass(ranges[i].Min, ranges[i].Max), symbol));
            }

            var counts = ClassBreaks.CountByRanges(values, ranges);
            _counts = keySymbols
                .Select((k, i) => (k.Key, Count: counts[i]))
                .ToDictionary(k => k.Key, k => k.Count);

            ApplyChanges();
        }
        finally
        {
            _processingWizard = false;
        }
    });

    private Task SetRotation() => HandleAsync(() =>
        _renderer?.SymbolRotation.EditProperties(AppScopeFactory, _layer?.FeatureClass)
        ?? Task.CompletedTask);

    // private Task SetCartographicsMethod() => HandleAsync(async () =>
    // {
    //     if (_renderer is null)
    //     {
    //         return;
    //     }

    //     var model = await AppScope.ShowModalDialog
    //         (typeof(LegendGroupCartographicMethodDialog),
    //         "Cartographic Method",
