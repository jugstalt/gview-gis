@inherits BaseHandler

@inject IApplicationScopeFactory AppScopeFactory

@if (_renderer is not null)
{
    <SimpleLabelRendererPropertyPage Instance="Instance" />

    <GvCard Title="Advanced: Font Color Expression">
        <GvCardContent>
            <GvGrid ColumnCount="2">
                <GvGridItem>
                    <MudTextField T="string"
                                  Label="Color Expression"
                                  Value="_renderer.ColorExpression"
                                  ValueChanged="OnColorExpressionChanged"
                                  Clearable="true" />
                </GvGridItem>
                <GvGridItem>
                    <div style="padding:8px">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="EditColorExpression">
                            Edit Expression
                        </MudButton>
                    </div>
                </GvGridItem>
            </GvGrid>
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense NoIcon>
                <p>
                    A gView expression, evaluated per feature - a plain <code>[Field]</code> reference,
                    or a full <code>@_scriptTokens</code> conditional script (same syntax as
                    the label expression).
                </p>
                <p>
                    Its result is passed to <code>ArgbColor.TryFromString()</code> and must resolve to a
                    colour. Accepted formats (spaces are ignored):
                    <code>#rgb</code> / <code>#rgba</code> / <code>#rrggbb</code> / <code>#aarrggbb</code>,
                    <code>r,g,b</code> or <code>r,g,b,a</code> (0-255),
                    <code>rgb(r,g,b)</code>, <code>rgba(r,g,b,a)</code> (a = 0..1),
                    <code>hsl(h,s%,l%)</code>, <code>hsla(h,s%,l%,a)</code>,
                    <code>cmyk(c,m,y,k)</code> (0-100), or a colour name
                    (<code>red</code>, <code>blue</code>, <code>gold</code>, ...).
                </p>
                <p>
                    An empty value - or anything that does not resolve to a colour - uses the text
                    symbol's own colour for that feature.
                </p>
            </MudAlert>
        </GvCardContent>
    </GvCard>
}

@code {
    [Parameter] public object? Instance { get; set; }

    private IFeatureLayer? _layer;
    private AdvancedLabelRenderer? _renderer;

    // Kept as a field so the literal "@@" tokens don't need Razor "@@"-escaping in the markup.
    private readonly string _scriptTokens = "@@start / @@if ... / @@end";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Instance is IFeatureLayer fLayer)
        {
            _layer = fLayer;
            _renderer = fLayer.LabelRenderer as AdvancedLabelRenderer;
        }
        else
        {
            _renderer = Instance as AdvancedLabelRenderer;
        }
    }

    private void OnColorExpressionChanged(string? value) => Handle(() =>
    {
        if (_renderer is not null)
        {
            _renderer.ColorExpression = value ?? string.Empty;
        }
    });

    private Task EditColorExpression() => HandleAsync(async () =>
    {
        if (_renderer is null)
        {
            return;
        }

        var model = await AppScopeFactory.ShowModalDialog(
            typeof(LabelExpressionDialog),
            "Font Color Expression",
            new LabelExpressionModel()
            {
                TableClass = _layer?.FeatureClass,
                Expression = _renderer.ColorExpression,
                IsColorExpression = true
            },
            new ModalDialogOptions()
            {
                Width = ModalDialogWidth.ExtraExtraLarge,
                FullWidth = false
            });

        if (model is not null)
        {
            _renderer.ColorExpression = model.Expression;
        }
    });
}
