@inherits ModalDialogFormBase<LabelExpressionModel>
@inject IJSRuntime JSRuntime

<ModalDialogFormBase T="LabelExpressionModel"
                     ContentStyle="DialogContentStyle.Full"
                     OnDialogClose="base.OnDialogClose"
                     Model="base.Model">
    <DialogBody>
        <GvGrid ColumnCount="3">
            <GvGridItem Span="1">
                <GvCard Title="Fields">
                    <GvCardContent>
                        <MudTextField T="string"
                                      @bind-Value="_fieldFilter"
                                      Immediate="true"
                                      Margin="Margin.Dense"
                                      Placeholder="Filter fields ..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="mb-2" />
                        <GvScrollable MaxHeight="32">
                            @if (Model?.TableClass?.Fields is not null)
                            {
                                <div class="field-list">
                                    @foreach (var field in FilteredFields())
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Size="MudBlazor.Size.Small"
                                                   FullWidth="true"
                                                   Class="field-btn"
                                                   StartIcon="@Icons.Material.Filled.DataObject"
                                                   OnClick="@(() => InsertField(field.name))">
                                            <span class="field-name">@field.name</span>
                                            <span class="field-type">@field.type</span>
                                        </MudButton>
                                    }
                                </div>
                            }
                        </GvScrollable>
                    </GvCardContent>
                </GvCard>

                <GvCard Title="Script Snippets">
                    <GvCardContent>
                        <div class="snippet-buttons">
                            <MudButton Variant="Variant.Outlined"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="InsertScriptTemplate">Script template</MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => InsertText(IfBlock))">@_ifButtonLabel</MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => InsertText(EndifToken))">@_endifButtonLabel</MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => InsertText(EndToken))">@_endButtonLabel</MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => InsertText(ReplaceToken))">@_replaceButtonLabel</MudButton>
                        </div>
                    </GvCardContent>
                </GvCard>
            </GvGridItem>

            <GvGridItem Span="1">
                <GvCard Title="Expression">
                    <GvCardContent>
                        <div class="expression-editor" style="width:100%">
                            <textarea @ref="_editor"
                                      id="gv-expression-editor"
                                      rows="20"
                                      wrap="off"
                                      spellcheck="false"
                                      autocomplete="off"
                                      autocorrect="off"
                                      autocapitalize="off"
                                      value="@Model.Expression"
                                      @oninput="OnEditorInput"
                                      placeholder="@_editorPlaceholder"
                                      style="width:100%;box-sizing:border-box;display:block;min-height:380px;resize:vertical;padding:12px 14px;font-family:'Cascadia Code','Consolas','Menlo','Courier New',monospace;font-size:0.85rem;line-height:1.5;tab-size:2;white-space:pre;overflow:auto;border:1px solid var(--mud-palette-lines-inputs);border-radius:var(--mud-default-borderradius);background-color:var(--mud-palette-background);color:var(--mud-palette-text-primary);outline:none"></textarea>
                        </div>

                        <div class="editor-status">
                            <MudIcon Size="MudBlazor.Size.Small"
                                     Icon="@(_isScript ? Icons.Material.Filled.Code : Icons.Material.Filled.TextFields)" />
                            <span>@(_isScript ? _scriptModeText : _plainModeText)</span>
                        </div>

                        @if (_lintWarning is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Text">
                                @_lintWarning
                            </MudAlert>
                        }
                        else if (_isScript)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Text">
                                Script structure looks valid.
                            </MudAlert>
                        }
                    </GvCardContent>
                </GvCard>
            </GvGridItem>

            <GvGridItem Span="1">
                @if (Model?.IsColorExpression == true)
                {
                    <GvCard Title="Colour values">
                        <GvCardContent>
                            <GvScrollable MaxHeight="34">
                                <div class="syntax-help">
                                    <pre>@LabelExpressionHelp.ColorValues</pre>
                                </div>
                            </GvScrollable>
                        </GvCardContent>
                    </GvCard>
                }

                <GvCard Title="Syntax reference">
                    <GvCardContent>
                        <GvScrollable MaxHeight="@(Model?.IsColorExpression == true ? 34f : 60f)">
                            <div class="syntax-help">
                                <pre>@SyntaxHelp</pre>
                            </div>
                        </GvScrollable>
                    </GvCardContent>
                </GvCard>
            </GvGridItem>
        </GvGrid>
    </DialogBody>
</ModalDialogFormBase>

@code {
    private ElementReference _editor;
    private string _fieldFilter = "";

    private bool _isScript;
    private string? _lintWarning;

    // Kept out of the markup so the literal "@@..." tokens don't need Razor "@@" escaping.
    private const string NL = "\n";
    private const string ScriptTemplate = "@@start\n@@if(condition)\n[FIELD]\n@@endif\n@@end\n";
    private const string IfBlock = "@@if(condition)\n\n@@endif\n";
    private const string EndifToken = "@@endif\n";
    private const string EndToken = "@@end\n";
    private const string ReplaceToken = "@@replace(search,replacement)\n";

    private readonly string _ifButtonLabel = "@@if( ) … @@endif";
    private readonly string _endifButtonLabel = "@@endif";
    private readonly string _endButtonLabel = "@@end";
    private readonly string _replaceButtonLabel = "@@replace( )";
    private readonly string _scriptModeText = "Script mode (@@start …)";
    private readonly string _plainModeText = "Plain text / field substitution";

    private readonly string _editorPlaceholder =
        "e.g.  [NAME]\n\nor a conditional script:\n\n@@start\n@@if([POPULATION],gt,10000)\n[NAME]\n@@endif\n@@end";

    private const string SyntaxHelp =
@"Plain text with [Field] placeholders - each placeholder is replaced with that field's value.

Conditional script - must begin with @@start on its own first line:

  @@start
  @@if(<condition>)
      ... line(s) emitted only while the condition is true ...
  @@endif
  @@end
  @@replace(search,replacement)      optional, applied after @@end

@@if(...) blocks can be nested (logical AND of all enclosing conditions).

Conditions:
  @@if(a)               a is not empty / whitespace
  @@if(a,b)             a equals b
  @@if(a,in,v1,v2,...)  a equals one of v1 .. vN
  @@if(a,op,b)          op = eq | not | lt | le | gt | ge
                        (lt/le/gt/ge compare numerically)

Tip: Tab inserts two spaces; the field and snippet buttons insert at the cursor.";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RecomputeLint();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.cartoInterops.expressionEditorEnableTab", _editor);
            await JSRuntime.InvokeVoidAsync("window.cartoInterops.expressionEditorFocus", _editor);
        }
    }

    private IEnumerable<gView.Framework.Core.Data.IField> FilteredFields()
    {
        var fields = (Model?.TableClass?.Fields?.ToEnumerable() ?? [])
            .Where(f => f.type != gView.Framework.Core.Data.FieldType.GEOMETRY
                     && f.type != gView.Framework.Core.Data.FieldType.binary);

        if (!string.IsNullOrWhiteSpace(_fieldFilter))
        {
            fields = fields.Where(f => f.name.Contains(_fieldFilter, StringComparison.OrdinalIgnoreCase));
        }

        return fields.OrderBy(f => f.name);
    }

    private void OnEditorInput(ChangeEventArgs e)
    {
        Model.Expression = e.Value?.ToString() ?? "";
        RecomputeLint();
    }

    private Task InsertField(string fieldName) => InsertText($"[{fieldName}]");

    private async Task InsertText(string text)
    {
        await JSRuntime.InvokeVoidAsync("window.cartoInterops.expressionEditorInsert", _editor, text);
        // JS mutates the textarea and raises 'input' -> OnEditorInput updates the model + lint.
    }

    private async Task InsertScriptTemplate()
    {
        if (string.IsNullOrWhiteSpace(Model.Expression))
        {
            Model.Expression = ScriptTemplate;
            RecomputeLint();
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("window.cartoInterops.expressionEditorFocus", _editor);
        }
        else
        {
            await InsertText(ScriptTemplate);
        }
    }

    private void RecomputeLint()
    {
        _lintWarning = null;
        var expr = Model?.Expression ?? "";

        _isScript = expr.TrimStart().StartsWith("@@start");
        if (!_isScript)
        {
            return;
        }

        var lines = expr.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');

        if (lines.Length == 0 || lines[0].Trim() != "@@start")
        {
            _lintWarning = "\"@@start\" must be on its own first line.";
            return;
        }

        int ifCount = 0, endifCount = 0;
        bool hasEnd = false;

        foreach (var raw in lines)
        {
            var line = raw.Trim();
            if (line.StartsWith("@@if("))
            {
                ifCount++;
            }
            else if (line == "@@endif")
            {
                endifCount++;
            }
            else if (line == "@@end")
            {
                hasEnd = true;
            }
        }

        if (!hasEnd)
        {
            _lintWarning = "The script has no \"@@end\" line.";
        }
        else if (ifCount != endifCount)
        {
            _lintWarning = $"\"@@if(...)\" / \"@@endif\" are unbalanced ({ifCount} vs {endifCount}).";
        }
    }
}
