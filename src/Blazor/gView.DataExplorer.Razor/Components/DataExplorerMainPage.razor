@implements IDisposable

@inject ExplorerEventBusService EventBus

<GvThemeProvider>

<GvAppBar AppName="Explorer" Icon="@MudBlazor.Icons.Material.Outlined.FolderOpen">
    <span class="gv-doc">@(_currentName)</span>
</GvAppBar>

<div class="dataexplorer-main">

    <div class="toolbar">
        <ToolRibbon />
    </div>

    <div class="navigation-bar">
        <NavBar />
    </div>

    <div class="tree gv-pane">
        <NavTree />
    </div>

    <div class="tree-content-splitter gv-splitter"></div>

    <div class="content gv-pane">
        <ContentView />
    </div>

    <div class="status-bar">
        <StatusBar />
    </div>

</div>

</GvThemeProvider>

<script src="_content/gView.DataExplorer.Razor/js/dataexplorer.js"></script>

@code{
    private string _currentName = "";

    protected override void OnInitialized()
    {
        EventBus.OnCurrentExplorerObjectChanged += OnCurrentExplorerObjectChanged;
    }

    private Task OnCurrentExplorerObjectChanged(IExplorerObject? exObject)
        => InvokeAsync(() =>
        {
            _currentName = exObject?.Name ?? "";
            StateHasChanged();
        });

    public void Dispose()
    {
        EventBus.OnCurrentExplorerObjectChanged -= OnCurrentExplorerObjectChanged;
    }
}
