@using Microsoft.JSInterop
@using gView.Blazor.Core.Models
@using gView.Blazor.Core.Services.Abstraction
@using gView.Framework.Common
@using gView.Razor.Services

@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject IAppIdentityProvider IdentityProvider
@inject CustomTilesService CustomTiles

<GvThemeProvider>

<div class="gv-page">
    <GvAppBar ShowLogin="true" />

    <main class="gv-page-main">
        <div class="gv-home-hero">
            <h1>gView GIS</h1>
            <p>
                Version @SystemInfo.Version
                @if (_identity?.IsAuthenticated == true ||
                     _identity?.IsAdministrator == true ||
                     _identity?.IsAuthorizedUser == true)
                {
                    <span> · @_identity.UserNameAndRole()</span>
                }
            </p>
        </div>

        <div class="gv-home-cards">
            @if (_identity?.IsAuthorizedUser == true)
            {
                <div class="gv-home-card" @onclick="() => NavigateTo(CartoUri)">
                    <MudIcon Icon="@Icons.Material.Outlined.Map" Class="gv-home-card-icon" />
                    <span class="gv-home-card-title">gView Carto</span>
                    <span class="gv-home-card-text">Create maps, include geographic data sources, render with cartographics capabilites</span>
                    <span class="gv-home-card-open" title="Open in a new tab" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Color="Color.Inherit" OnClick="() => NavigateTo(CartoUri, true)" />
                    </span>
                </div>
            }
            @if (_identity?.IsAdministrator == true)
            {
                <div class="gv-home-card" @onclick="() => NavigateTo(ExplorerUri)">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Class="gv-home-card-icon" />
                    <span class="gv-home-card-title">gView Explorer</span>
                    <span class="gv-home-card-text">Explore geographic data, copy data between datasets, run workloads to manage your data</span>
                    <span class="gv-home-card-open" title="Open in a new tab" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Color="Color.Inherit" OnClick="() => NavigateTo(ExplorerUri, true)" />
                    </span>
                </div>

                @foreach (var customTile in CustomTiles.Tiles)
                {
                    <div class="gv-home-card custom"
                         style="@("".AppendBackgroundColor(customTile.BackgroundColor).AppendColor(customTile.FontColor))"
                         @onclick="() => NavigateTo(customTile.TargetUrl)">
                        <MudIcon Icon="@Icons.Material.Outlined.Apps" Class="gv-home-card-icon" />
                        <span class="gv-home-card-title">@customTile.Title</span>
                        <span class="gv-home-card-text">@customTile.Description</span>
                        <span class="gv-home-card-open" title="Open in a new tab" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Color="Color.Inherit" OnClick="() => NavigateTo(customTile.TargetUrl, true)" />
                        </span>
                    </div>
                }

                <div class="gv-home-card static">
                    <MudIcon Icon="@Icons.Material.Outlined.Memory" Class="gv-home-card-icon" />
                    <span class="gv-home-card-title">Used Memory</span>
                    <span class="gv-home-card-text"><span class="gv-home-card-value">@((int)(GC.GetTotalMemory(false) / 1024.0 / 1024.0))</span> MB</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="gv-home-card-action"
                               StartIcon="@Icons.Material.Outlined.CleaningServices"
                               OnClick="CollectMemory">
                        Collect
                    </MudButton>
                </div>
            }
        </div>
    </main>
</div>

</GvThemeProvider>


@code {
    private const string CartoUri = "carto";
    private const string ExplorerUri = "explorer";

    private AppIdentity? _identity;

    async protected override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _identity = IdentityProvider.Identity;
    }

    async private Task NavigateTo(string uri, bool newTab = false)
    {
        if (newTab)
        {
            await JSRuntime.InvokeVoidAsync("open", uri, "_blank");
        }
        else
        {
            Nav.NavigateTo(uri, true);
        }
    }

    private void CollectMemory()
    {
        GC.Collect();
        GC.WaitForPendingFinalizers();
        GC.Collect();
    }
}