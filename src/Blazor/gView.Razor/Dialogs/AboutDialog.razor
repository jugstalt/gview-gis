@using gView.Blazor.Core.Models
@using gView.Blazor.Core.Services.Abstraction
@inherits ModalDialogFormBase<AboutDialogModel>

@inject IAppIdentityProvider IdentityProvider

@* same look as the start page: hero with contour lines, info rows, license *@
<ModalDialogFormBase T="AboutDialogModel"
                     OnDialogClose="base.OnDialogClose"
                     Model="base.Model">
    <FormContent>
        <div class="gv-about">
            <div class="gv-about-hero">
                <div class="gv-hero-contours"></div>
                <div class="gv-about-hero-inner">
                    <MudIcon Icon="@Icons.Material.Outlined.Map" Class="gv-about-mark" />
                    <div>
                        <div class="gv-about-title">@Model.Title</div>
                        <div class="gv-about-version">Version @Model.Version</div>
                    </div>
                </div>
            </div>

            <dl class="gv-about-info">
                <dt>User</dt>
                <dd>@IdentityProvider.Identity.UserNameAndRole()</dd>
                <dt>Graphics engine</dt>
                <dd>@(gView.GraphicsEngine.Current.Engine?.EngineDisplayName ?? "Unknown")</dd>
                <dt>Documentation</dt>
                <dd><a class="gv-link" href="https://docs.gviewonline.com" target="_blank" rel="noopener">docs.gviewonline.com</a></dd>
                <dt>Source code</dt>
                <dd><a class="gv-link" href="https://github.com/jugstalt/gview-gis" target="_blank" rel="noopener">github.com/jugstalt/gview-gis</a></dd>
            </dl>

            <div class="gv-about-section-title">License</div>
            <pre class="gv-about-license">@licText</pre>
        </div>
    </FormContent>
    <DialogButtons>
        <div />
    </DialogButtons>
</ModalDialogFormBase>

@code {
    private string licText = "";

    async protected override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        GC.Collect();

        try
        {
            licText = gView.Razor.Properties.Resources.License.Replace("{YEAR}", DateTime.Now.Year.ToString());
        }
        catch { }
    }
}
