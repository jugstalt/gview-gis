@using gView.Server.AppCode
@using gView.Framework.Common

@inject gView.Server.Services.Hosting.UrlHelperService UrlHelperService
@{
    var rootUrl = UrlHelperService.AppRootUrl(this.Context.Request);
    var title = ViewData["Title"] as string;
    var crumbs = ViewData["menuItems"] as Dictionary<string, string>;
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-theme-pref="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(String.IsNullOrEmpty(title) ? "gView Server" : $"{title} · gView Server")</title>
    <script>
        (function () {
            var pref = 'system';
            try { pref = localStorage.getItem('gview-server-theme') || 'system'; } catch (e) { }
            var dark = pref === 'dark' || (pref === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme-pref', pref);
        })();
    </script>

    <link rel="stylesheet" href="~/css/site.css?@(SystemInfo.Version.ToString())" />
</head>
<body>
    <partial name="_CookieConsentPartial" />

    <div class="app">
        <partial name="_portalSidebarPartial" />

        <div class="app-main">
            <header class="app-top">
                <nav class="app-crumb" aria-label="Breadcrumb">
                    <a href="@rootUrl/">gView Server</a>
                    @if (crumbs != null && crumbs.Count > 0)
                    {
                        foreach (var crumb in crumbs)
                        {
                            <span class="ico ico-chevron"></span>
                            <a href="@crumb.Value">@crumb.Key</a>
                        }
                    }
                    else if (!String.IsNullOrEmpty(title))
                    {
                        <span class="ico ico-chevron"></span>
                        <span>@title</span>
                    }
                </nav>
                <div class="theme-switch" role="group" aria-label="Color mode">
                    <button type="button" data-theme-set="light" title="Light" onclick="gview.server.setTheme('light')"><span class="ico ico-sun"></span></button>
                    <button type="button" data-theme-set="system" title="System" onclick="gview.server.setTheme('system')"><span class="ico ico-monitor"></span></button>
                    <button type="button" data-theme-set="dark" title="Dark" onclick="gview.server.setTheme('dark')"><span class="ico ico-moon"></span></button>
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-foot">
                <span>Rendering: @(gView.GraphicsEngine.Current.Engine.EngineDisplayName)</span>
                @if (gView.GraphicsEngine.Current.Encoder != null)
                {
                    <span>Encoding: @(gView.GraphicsEngine.Current.Encoder.EngineName)</span>
                }
                <span>Projection: @gView.Framework.Geometry.GeometricTransformerFactory.TransformerType</span>
                <span class="grow"></span>
                <span>Version @SystemInfo.Version.ToString()</span>
            </footer>
        </div>
    </div>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/js/site.js?@(SystemInfo.Version.ToString())"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/js/site.min.js?@(SystemInfo.Version.ToString())"></script>
    </environment>

    @RenderSection("Scripts", required: false)

    <script type="text/javascript">
        (function () {
            window.gview.server.setRootUrl('@(rootUrl)')
        })();
    </script>
</body>
</html>
