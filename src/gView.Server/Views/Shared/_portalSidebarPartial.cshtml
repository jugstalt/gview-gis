@using gView.Server.AppCode
@inject gView.Server.Services.Hosting.UrlHelperService UrlHelperService
@inject gView.Server.Services.Security.LoginManager LoginManager
@{
    var rootUrl = UrlHelperService.AppRootUrl(this.Context.Request);
    var username = LoginManager.LoginUsername(this.Context.Request);
    var isManageUser = LoginManager.IsManageUser(this.Context.Request);
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();

    string Active(bool isActive) => isActive ? "active" : "";
}

<aside class="app-side">
    <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="ico ico-map"></span>
        <span>gView<b>Server</b></span>
        <em>v@(gView.Framework.Common.SystemInfo.Version.Major)</em>
    </a>

    <nav class="app-nav">
        <a class="@Active(controller == "home" && action == "index")" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="ico ico-home"></span><span>Home</span>
        </a>
        <div class="app-nav-label">Services</div>
        <a class="@Active(controller == "browseservices")" asp-area="" asp-controller="BrowseServices" asp-action="Index">
            <span class="ico ico-layers"></span><span>Browse Services</span>
        </a>
        <a class="@Active(controller.StartsWith("geoservices"))" href="@rootUrl/geoservices/rest/services">
            <span class="ico ico-code"></span><span>GeoServices (REST)</span>
        </a>
        <a href="@rootUrl/ogcapi?f=html">
            <span class="ico ico-plug"></span><span>OGC API</span>
        </a>
        @if (this.Context.Request.IsFromAdminNetwork() && (isManageUser || (Globals.AllowFormsLogin && String.IsNullOrWhiteSpace(username))))
        {
            <a class="@Active(controller == "manage")" asp-area="" asp-controller="Manage" asp-action="Index">
                <span class="ico ico-shield"></span><span>Manage</span>
            </a>
        }
    </nav>

    <nav class="app-nav bottom">
        @if (!String.IsNullOrWhiteSpace(username))
        {
            <div class="app-user" title="Logged in"><span class="ico ico-users"></span><span>@username</span></div>
            <a asp-area="" asp-controller="Token" asp-action="Logout">
                <span class="ico ico-logout"></span><span>Logout</span>
            </a>
        }
        else if (Globals.AllowFormsLogin)
        {
            <a class="@Active(controller == "token" && action == "login")" asp-area="" asp-controller="Token" asp-action="Login">
                <span class="ico ico-login"></span><span>Login</span>
            </a>
        }
        <a class="@Active(controller == "home" && action == "about")" href="@rootUrl/home/about">
            <span class="ico ico-info"></span><span>About</span>
        </a>
    </nav>
</aside>
