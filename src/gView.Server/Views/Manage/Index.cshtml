@inject gView.Server.Services.Hosting.UrlHelperService UrlHelperService
@{
    ViewData["Title"] = "Manage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-head">
    <h1>Manage</h1>
</div>
<nav class="manage-tabs">
    <a href="" class="active" data-page="services" onclick="window.gview.manage.pageServices(); return false;"><span class="ico ico-server"></span>Services</a>
    <a href="" data-page="security" onclick="window.gview.manage.pageSecurity(); return false;"><span class="ico ico-users"></span>Security</a>
</nav>
<div class="gview-manage-body">

</div>

@Html.AntiForgeryToken()

@section Scripts {

    <environment include="Development">
        <script src="~/js/manage.js?@(SystemInfo.Version.ToString())"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/manage.js?@(SystemInfo.Version.ToString())"></script>
    </environment>

    <script type="text/javascript">

        $('.manage-tabs a').click(function () {
            $(this).addClass('active').siblings().removeClass('active');
        });

        window.require = { paths: { vs: '@(UrlHelperService.AppRootUrl(this.Context.Request))/lib/monaco-editor/min/vs' } };

        (function () {
            window.gview.manage.setRootUrl('@(UrlHelperService.AppRootUrl(this.Context.Request))')
            window.gview.manage.pageServices();
        })();
    </script>

    <script src="~/lib/monaco-editor/min/vs/loader.js"></script>
    <script src="~/lib/monaco-editor/min/vs/editor/editor.main.nls.js"></script>
    <script src="~/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
}

