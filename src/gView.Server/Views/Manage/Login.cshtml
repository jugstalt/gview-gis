@inject gView.Server.Services.Hosting.UrlHelperService UrlHelperService
@{
    ViewData["Title"] = "Login (Manager)";
    ViewData["SubTitle"] = "gView Server";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@model ManageLoginModel;

<div class="gview-login-panel">
    <div class="title">
        <div class="login-logo"><span class="ico ico-map"></span></div>
        <div>
            <h3>@ViewData["Title"]</h3>
            <div class="subtitle">@ViewData["SubTitle"]</div>
        </div>
    </div>
    @if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-message">
            @Model.ErrorMessage
        </div>
    }
    <form action="@(UrlHelperService.AppRootUrl(this.Context.Request))/Manage/Login" method="post">
        @*<h4>Use a local account to log in.</h4>*@
        @Html.AntiForgeryToken()
        
        @if (Model.SetupRequired)
        {
            <div class="attribute">
                <div>
                    No admin login exists yet. Enter the setup code from the server log
                    (or set GVIEW_ADMIN_USER and GVIEW_ADMIN_PASSWORD) to create the admin.
                </div>
            </div>
            <div class="attribute">
                <div>
                    <div class="label">Setup code</div>
                    <input asp-for="SetupCode" class="form-control" autocomplete="off" placeholder="XXXX-XXXX-XXXX" />
                </div>
            </div>
        }
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="attribute">
            <div>
                <div class="label">Username</div>
                <input asp-for="Username" class="form-control" autofocus placeholder="Username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="attribute">
            <div>
                <div class="label">Password</div>
                <input asp-for="Password" class="form-control" autofocus placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        @if (Model.SetupRequired)
        {
            <div class="attribute">
                <div>
                    <div class="label">Repeat password</div>
                    <input asp-for="PasswordRepeat" class="form-control" placeholder="Repeat password" />
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">@(Model.SetupRequired ? "Create admin" : "Login")</button>
    </form>
</div>
