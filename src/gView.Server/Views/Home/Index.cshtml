@using gView.Server.AppCode
@inject gView.Server.Services.Hosting.UrlHelperService UrlHelperService
@inject gView.Server.Services.Security.LoginManager LoginManager
@{
    ViewData["Title"] = "Home";
    var rootUrl = UrlHelperService.AppRootUrl(this.Context.Request);
    var username = LoginManager.LoginUsername(this.Context.Request);
    var isManageUser = LoginManager.IsManageUser(this.Context.Request);
    var hasManagerLogin = LoginManager.HasManagerLogin();
}

<div class="home-hero">
    <div class="home-hero-contours"></div>
    <div class="home-hero-inner">
        <h1>gView Server</h1>
        <p>Map and feature services for your geographic data: GeoServices REST, OGC WMS, WFS, WMTS and OGC API.</p>
        <span class="home-hero-version">Version @SystemInfo.Version.ToString()</span>
    </div>
</div>

<div class="quicklinks">
    <a class="@(!hasManagerLogin ? "disabled" : "")" asp-area="" asp-controller="BrowseServices" asp-action="Index">
        <div class="ql-icon"><span class="ico ico-layers"></span></div>
        <b>Browse Services</b>
        <span>Folders, services and all their interfaces</span>
    </a>
    <a class="@(!hasManagerLogin ? "disabled" : "")" href="@rootUrl/geoservices/rest/services">
        <div class="ql-icon"><span class="ico ico-code"></span></div>
        <b>GeoServices (REST)</b>
        <span>/geoservices/rest/services</span>
    </a>
    <a href="@rootUrl/ogcapi?f=html">
        <div class="ql-icon"><span class="ico ico-plug"></span></div>
        <b>OGC API</b>
        <span>/ogcapi</span>
    </a>
    @if (this.Context.Request.IsFromAdminNetwork() && (isManageUser || (Globals.AllowFormsLogin && String.IsNullOrWhiteSpace(username))))
    {
        <a class="@(!hasManagerLogin ? "required" : "")" asp-area="" asp-controller="Manage" asp-action="Index">
            <div class="ql-icon"><span class="ico ico-shield"></span></div>
            <b>Manage</b>
            <span>Services, security, metadata, networks</span>
        </a>
    }
</div>

<h2 class="section-title">Engine</h2>
<table class="kv">
    <tr><td>Rendering</td><td>@(gView.GraphicsEngine.Current.Engine.EngineDisplayName)</td></tr>
    @if (gView.GraphicsEngine.Current.Encoder != null)
    {
        <tr><td>Encoding</td><td>@(gView.GraphicsEngine.Current.Encoder.EngineName)</td></tr>
    }
    <tr><td>Projection</td><td>@gView.Framework.Geometry.GeometricTransformerFactory.TransformerType</td></tr>
    <tr><td>Version</td><td>@SystemInfo.Version.ToString()</td></tr>
</table>
