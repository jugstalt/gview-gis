﻿@using System.Reflection

@{
    string license = "";
    try {
        var rootPath = System.IO.Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
        license = System.IO.File.ReadAllText(System.IO.Path.Combine(rootPath, "_lics", "license.txt"))
                                .Replace("{YEAR}", DateTime.Now.Year.ToString());
    } catch {}

    ViewData["Title"] = "About";
}
<div class="page-about">

    <div class="home-hero">
        <div class="home-hero-contours"></div>
        <div class="home-hero-inner">
            <h1>gView Server</h1>
            <span class="home-hero-version">Version @SystemInfo.Version.ToString()</span>
            <p class="home-hero-links">
                <a href="https://docs.webgiscloud.com/gview/en/index.html" target="_blank" rel="noopener"><span class="ico ico-external"></span> Documentation</a>
                <a href="https://github.com/jugstalt/gview-gis" target="_blank" rel="noopener"><span class="ico ico-external"></span> GitHub</a>
            </p>
        </div>
    </div>

    <pre class="gview-license">
@license
    </pre>
</div>
