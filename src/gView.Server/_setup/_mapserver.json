{
  "services-folder": "{repository-path}/server/configuration",
  "output-path": "{repository-path}/server/web/output",
  "output-url": "{server-url}/output",
  "onlineresource-url": "{server-url}",
  "tilecache-root": "{repository-path}/server/web/tile-caches",

  "task-queue": {
    "max-parallel-tasks": 10,
    "max-queue-length": 1000
  },

  "allowFormsLogin": true,
  "force-https": false,

  "graphics": {
    "rendering": "skia",
    "encoding": "skia"
  },

  // Font files (*.ttf, *.otf, *.ttc) in these directories are made available for
  // rendering at server start - no OS font installation required (Windows + Linux).
  "fonts": {
    "directories": [ "{repository-path}/fonts" ],
    // optional: additionally copy the fonts into the per-user OS font store
    "install-to-system": false
  },

  "proj-engine": {
    "engine": "ManageProj4Parallel" // ManagedProj4, NativeProj4
  },

  "CriticalErrorLevel": {
    "ErrorType": "error"
  }
}