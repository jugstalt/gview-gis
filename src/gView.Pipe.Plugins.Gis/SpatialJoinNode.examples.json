    "output": [
      { "type": "Feature", "geometry": { "type": "LineString", "coordinates": [ [ 0, 5 ], [ 5, 5 ] ] }, "properties": { "line_id": "L-1" }, "srs": 31256 }
    ],
    "verified": false
  },
