  {
    "title": "Where does a house connection meet the street?",
    "description": "Locate along line: main gets points, overlay the lines. Each point learns the position, fraction, offset and distance to its nearest line; Point on the line snaps it.",
    "parameters": {
      "operation": "locateAlongLine",
      "prefix": "street_",
      "locateMaxDistance": 20
    },
    "input": [
      {
        "type": "Feature",
        "geometry": {
          "type": "Point",
          "coordinates": [ 30, 4 ]
        },
        "properties": {
          "house": "12"
        },
        "srs": 31256
      }
    ],
    "output": [
      {
        "type": "Feature",
        "geometry": {
          "type": "Point",
          "coordinates": [ 30, 4 ]
        },
        "properties": {
          "house": "12",
          "street_position": 30,
          "street_fraction": 0.3,
          "street_offset": 4,
          "street_distance": 4,
          "street_name": "Main Street"
        },
        "srs": 31256
      }
    ],
    "verified": false
  }
