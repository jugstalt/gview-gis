<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    gView.Pipe.Abstraction is not on nuget.org yet. Pack it in the sibling checkout of gview-pipe:
      dotnet pack src/gView.Pipe.Abstraction -c Release -o artifacts/packages
  -->
  <packageSources>
    <add key="gview-pipe-local" value="../../../gview-pipe/artifacts/packages" />
  </packageSources>
</configuration>
