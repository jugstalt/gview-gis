      { "type": "Feature", "id": 91, "geometry": null, "properties": { "TRANSFORMER_ID": 4711, "BRANCH_ID": 124, "SUPPLY_KIND": "Multiple", "SOURCE_CLASS": 997, "BRANCH_CLASS": 997 }, "srs": 31256 },
      { "type": "Feature", "id": 95, "geometry": null, "properties": { "TRANSFORMER_ID": 4712, "BRANCH_ID": 310, "SUPPLY_KIND": "Open", "SOURCE_CLASS": 998, "BRANCH_CLASS": 998 }, "srs": 31256 }
