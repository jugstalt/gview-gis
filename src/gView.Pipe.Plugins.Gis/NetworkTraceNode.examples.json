  {
    "title": "Output fields ready to write back",
    "description": "The output fields put the ids, the kind and the classes (object id modulo Classes) under the names of the feature class; Only the output fields leaves id and these fields, so Write Features (update by object id) follows directly, without a Set node. Open lines adds the lines no branch went along at a reached node, e.g. switched off at the separation point of a ring, with the Open class 998; Multiple class marks rings and double supply.",
    "parameters": {
      "operation": "feeders",
      "sources": "[MediumVoltage,Transformer,*]",
      "branches": "[LowVoltage,Connector,*]",
      "tier": "LowVoltage",
      "outputTypes": "[LowVoltage,Line,*]",
      "openLines": true,
      "sourceIdField": "TRANSFORMER_ID",
      "branchIdField": "BRANCH_ID",
      "kindField": "SUPPLY_KIND",
      "sourceClassField": "SOURCE_CLASS",
      "branchClassField": "BRANCH_CLASS",
      "classes": 100,
      "multipleClass": 997,
      "openClass": 998,
      "onlyOutputFields": true
    },
    "input": [],
    "output": [
