    ],
    "output": [
      { "type": "Feature", "geometry": { "type": "Polygon", "coordinates": [ [ [ 0, 0 ], [ 20, 0 ], [ 20, 10 ], [ 0, 10 ], [ 0, 0 ] ] ] }, "properties": { "parcel": "112/4", "area_m2": 200 }, "srs": 31256 }
